{
  "name": "@rodokmen/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@rodokmen/shared": "workspace:*",
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.7",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^4.1.12"
  },
  "description": "Rodokmen Tree backend: read API, member accounts and operations",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsx watch --conditions=@rodokmen/source src/main.ts",
    "cli": "tsx --conditions=@rodokmen/source src/cli.ts",
    "openapi": "tsx --conditions=@rodokmen/source src/cli.ts openapi write",
    "openapi:check": "tsx --conditions=@rodokmen/source src/cli.ts openapi check"
  }
}
