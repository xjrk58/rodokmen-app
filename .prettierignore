server/openapi.json
server/test/__snapshots__/
# Golden files of the Charts (tree-charts) and of kinship, rewritten only with UPDATE_GOLDEN=1 and compared byte for byte.
shared/test/golden/
server/test/golden/
app/tests/unit/golden/
# OpenSpec changes and specs, and the Claude Code commands that drive them.
openspec/
.claude/

# Generated, and compared byte for byte by the scripts that write them.
docs/verification.md
docs/architecture/generated/


# LemmaScript working files (git-ignored), written by `pnpm --filter @rodokmen/shared verify`.
**/.lemmascript/

# The mocked kinship answers, written by app/tests/unit/kinship-answers.test.mjs and compared byte for byte.
app/tests/e2e/family-kinship.json
# The mocked kinship on Chart cards, written by app/tests/unit/chart-kinship.test.mjs and compared byte for byte.
app/tests/e2e/chart-kinship.json
