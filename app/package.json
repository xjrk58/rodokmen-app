{
  "name": "@rodokmen/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rodokmen map: archive lookup, place search and historical maps for the Czech lands, as a static PWA.",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "build-data": "node scripts/build-data.mjs",
    "vendor": "node scripts/vendor-leaflet.mjs && node scripts/vendor-preact.mjs",
    "check-links": "node scripts/check-links.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "node --test \"tests/unit/*.test.mjs\" && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.22",
    "@types/node": "^22.10.0",
    "htm": "3.1.1",
    "leaflet": "1.9.4",
    "mapshaper": "0.7.101",
    "preact": "10.29.8",
    "typescript": "6.0.3"
  }
}
