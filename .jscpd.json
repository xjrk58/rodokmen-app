{
  "minLines": 30,
  "format": ["javascript", "typescript"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.lemmascript/**",
    "app/vendor/**",
    "app/data/**",
    "app/tests/**",
    "server/test/**",
    "server/mcp/test/**",
