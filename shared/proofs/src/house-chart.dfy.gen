predicate JSStringLt(s: string, t: string)
  decreases |s|
{
  if |s| == 0 then |t| > 0
  else if |t| == 0 then false
  else if s[0] != t[0] then s[0] < t[0]
  else JSStringLt(s[1..], t[1..])
}

datatype Placement = Placement(row: int, type_: string, role: string, dated: bool, openStart: bool, openEnd: bool, earliest: int, latest: int)

datatype HouseRows = HouseRows(by_: seq<int>, dated: seq<bool>, openStart: seq<bool>, openEnd: seq<bool>, earliest: seq<int>, latest: seq<int>, first: seq<int>, last: seq<int>)

datatype RowKey = RowKey(dated: bool, day: int, key: string)

datatype Succession = Succession(kind: seq<int>, from: seq<int>, through: seq<int>, marriedIn: seq<int>)

datatype RowChild = RowChild(child: int, row: int)

function placesAtHouse(type_: string, role: string): bool
{
  if ((((role == "godparent") || (role == "witness")) || (role == "priest")) || (role == "informant")) then
    false
  else
    if ((type_ == "birth") || (type_ == "baptism")) then
      (((role == "child") || (role == "father")) || (role == "mother"))
    else
      if (type_ == "marriage") then
        (role == "partner")
      else
        ((((type_ == "residence") || (type_ == "census")) || (type_ == "death")) || (type_ == "burial"))
}

lemma placesAtHouse_ensures(type_: string, role: string)
  ensures (((((role == "godparent") || (role == "witness")) || (role == "priest")) || (role == "informant")) ==> !(placesAtHouse(type_, role)))
  ensures (((type_ == "birth") || (type_ == "baptism")) ==> (placesAtHouse(type_, role) == (((role == "child") || (role == "father")) || (role == "mother"))))
  ensures ((type_ == "marriage") ==> (placesAtHouse(type_, role) == (role == "partner")))
{
}

function marriedLater(marriageDated: bool, marriageEarliest: int, eventOpenEnd: bool, eventLatest: int): bool
{
  ((marriageDated && !(eventOpenEnd)) && (marriageEarliest > eventLatest))
}

function bounds(placements: seq<Placement>, i: int): bool
  requires (0 <= i)
  requires (i < |placements|)
{
  var p := placements[i];
  (placesAtHouse(p.type_, p.role) && p.dated)
}

function compareRows(a: RowKey, b: RowKey): int
{
  if (a.dated != b.dated) then
    if a.dated then
      -1
    else
      1
  else
    if (a.dated && (a.day != b.day)) then
      if (a.day < b.day) then
        -1
      else
        1
    else
      if JSStringLt(a.key, b.key) then
        -1
      else
        if JSStringLt(b.key, a.key) then
          1
        else
          0
}

lemma compareRows_ensures(a: RowKey, b: RowKey)
  ensures (compareRows(a, b) == (-(compareRows(b, a))))
  ensures (-1 <= compareRows(a, b))
  ensures (compareRows(a, b) <= 1)
  ensures ((compareRows(a, b) == 0) ==> (a.key == b.key))
  ensures (a.dated ==> b.dated ==> (a.day < b.day) ==> (compareRows(a, b) == -1))
  ensures (a.dated ==> !(b.dated) ==> (compareRows(a, b) == -1))
{
}

function isChildOf(children: seq<RowChild>, p: int, r: int): bool
{
  ((p >= 0) && (exists c :: c in children && ((c.child == p) && (c.row == r))))
}

function isChildBefore(children: seq<RowChild>, p: int, r: int): bool
{
  ((p >= 0) && (exists c :: c in children && ((c.child == p) && (c.row < r))))
}

function sharePartner(a: seq<int>, b: seq<int>, r: int, j: int): bool
  requires (|a| == |b|)
  requires (0 <= r)
  requires (r < |a|)
  requires (0 <= j)
  requires (j < |a|)
{
  (((a[r] >= 0) && ((a[r] == a[j]) || (a[r] == b[j]))) || ((b[r] >= 0) && ((b[r] == a[j]) || (b[r] == b[j]))))
}

function linked(a: seq<int>, b: seq<int>, children: seq<RowChild>, r: int, j: int): bool
  requires (|a| == |b|)
  requires (0 <= r)
  requires (r < |a|)
  requires (0 <= j)
  requires (j < |a|)
{
  ((isChildOf(children, a[r], j) || isChildOf(children, b[r], j)) || sharePartner(a, b, r, j))
}

const NO_LINK: int := 0

const SON: int := 1

const DAUGHTER: int := 2

const CHILD: int := 3

const REMARRIAGE: int := 4

method familyAt(marriageDated: seq<bool>, marriageEarliest: seq<int>, eventOpenEnd: bool, eventLatest: int) returns (res: int)
  requires (|marriageDated| == |marriageEarliest|)
  ensures (-1 <= res)
  ensures (res < |marriageDated|)
  ensures ((res >= 0) ==> !(marriedLater(marriageDated[res], marriageEarliest[res], eventOpenEnd, eventLatest)))
  ensures forall j: nat :: ((j < |marriageDated|) ==> (j > res) ==> marriedLater(marriageDated[j], marriageEarliest[j], eventOpenEnd, eventLatest))
{
  var found := -1;
  var i := 0;
  while (i < |marriageDated|)
    invariant (0 <= i)
    invariant (i <= |marriageDated|)
    invariant (-1 <= found)
    invariant (found < i)
    invariant ((found >= 0) ==> !(marriedLater(marriageDated[found], marriageEarliest[found], eventOpenEnd, eventLatest)))
    invariant forall j: nat :: ((j < i) ==> (j > found) ==> marriedLater(marriageDated[j], marriageEarliest[j], eventOpenEnd, eventLatest))
    decreases (|marriageDated| - i)
  {
    var i_t0 := marriedLater(marriageDated[i], marriageEarliest[i], eventOpenEnd, eventLatest);
    if !(i_t0) {
      found := i;
    }
    i := (i + 1);
  }
  return found;
}

method houseRows(rowCount: int, placements: seq<Placement>) returns (res: HouseRows)
  requires (rowCount >= 0)
  requires forall i: nat :: ((i < |placements|) ==> ((0 <= placements[i].row) && (placements[i].row < rowCount)))
  ensures (|res.by_| == rowCount)
  ensures (|res.dated| == rowCount)
  ensures (|res.openStart| == rowCount)
  ensures (|res.openEnd| == rowCount)
  ensures (|res.earliest| == rowCount)
  ensures (|res.latest| == rowCount)
  ensures (|res.first| == rowCount)
  ensures (|res.last| == rowCount)
  ensures forall r: nat :: ((r < rowCount) ==> (res.by_[r] >= 0) ==> (((res.by_[r] < |placements|) && (placements[res.by_[r]].row == r)) && placesAtHouse(placements[res.by_[r]].type_, placements[res.by_[r]].role)))
  ensures forall i: nat :: ((i < |placements|) ==> placesAtHouse(placements[i].type_, placements[i].role) ==> (res.by_[placements[i].row] >= 0))
  ensures forall i: nat :: ((i < |placements|) ==> bounds(placements, i) ==> res.dated[placements[i].row])
  ensures forall i: nat :: ((i < |placements|) ==> bounds(placements, i) ==> placements[i].openStart ==> res.openStart[placements[i].row])
  ensures forall i: nat :: ((i < |placements|) ==> bounds(placements, i) ==> placements[i].openEnd ==> res.openEnd[placements[i].row])
  ensures forall i: nat :: ((i < |placements|) ==> bounds(placements, i) ==> !(placements[i].openStart) ==> (res.earliest[placements[i].row] <= placements[i].earliest))
  ensures forall i: nat :: ((i < |placements|) ==> bounds(placements, i) ==> !(placements[i].openEnd) ==> (placements[i].latest <= res.latest[placements[i].row]))
  ensures forall r: nat :: ((r < rowCount) ==> (res.first[r] >= 0) ==> (((((res.first[r] < |placements|) && (placements[res.first[r]].row == r)) && bounds(placements, res.first[r])) && !(placements[res.first[r]].openStart)) && (placements[res.first[r]].earliest == res.earliest[r])))
  ensures forall r: nat :: ((r < rowCount) ==> (res.last[r] >= 0) ==> (((((res.last[r] < |placements|) && (placements[res.last[r]].row == r)) && bounds(placements, res.last[r])) && !(placements[res.last[r]].openEnd)) && (placements[res.last[r]].latest == res.latest[r])))
  ensures forall r: nat :: ((r < rowCount) ==> res.dated[r] ==> !(res.openStart[r]) ==> (res.first[r] >= 0))
  ensures forall r: nat :: ((r < rowCount) ==> res.dated[r] ==> !(res.openEnd[r]) ==> (res.last[r] >= 0))
  ensures forall r: nat :: ((r < rowCount) ==> res.dated[r] ==> (res.by_[r] >= 0))
{
  var by_: seq<int> := [];
  var dated: seq<bool> := [];
  var openStart: seq<bool> := [];
  var openEnd: seq<bool> := [];
  var earliest: seq<int> := [];
  var latest: seq<int> := [];
  var first: seq<int> := [];
  var last: seq<int> := [];
  var r := 0;
  while (r < rowCount)
    invariant (0 <= r)
    invariant (r <= rowCount)
    invariant (|by_| == r)
    invariant (|dated| == r)
    invariant (|openStart| == r)
    invariant (|openEnd| == r)
    invariant (|earliest| == r)
    invariant (|latest| == r)
    invariant (|first| == r)
    invariant (|last| == r)
    invariant forall s: nat :: ((s < r) ==> ((((((by_[s] == -1) && !(dated[s])) && !(openStart[s])) && !(openEnd[s])) && (first[s] == -1)) && (last[s] == -1)))
    decreases (rowCount - r)
  {
    by_ := (by_ + [-1]);
    dated := (dated + [false]);
    openStart := (openStart + [false]);
    openEnd := (openEnd + [false]);
    earliest := (earliest + [0]);
    latest := (latest + [0]);
    first := (first + [-1]);
    last := (last + [-1]);
    r := (r + 1);
  }
  var i := 0;
  while (i < |placements|)
    invariant (0 <= i)
    invariant (i <= |placements|)
    invariant (|by_| == rowCount)
    invariant (|dated| == rowCount)
    invariant (|openStart| == rowCount)
    invariant (|openEnd| == rowCount)
    invariant (|earliest| == rowCount)
    invariant (|latest| == rowCount)
    invariant (|first| == rowCount)
    invariant (|last| == rowCount)
    invariant forall s: nat :: ((s < rowCount) ==> (by_[s] >= 0) ==> (((by_[s] < |placements|) && (placements[by_[s]].row == s)) && placesAtHouse(placements[by_[s]].type_, placements[by_[s]].role)))
    invariant forall j: nat :: ((j < i) ==> placesAtHouse(placements[j].type_, placements[j].role) ==> (by_[placements[j].row] >= 0))
    invariant forall j: nat :: ((j < i) ==> bounds(placements, j) ==> dated[placements[j].row])
    invariant forall j: nat :: ((j < i) ==> bounds(placements, j) ==> placements[j].openStart ==> openStart[placements[j].row])
    invariant forall j: nat :: ((j < i) ==> bounds(placements, j) ==> placements[j].openEnd ==> openEnd[placements[j].row])
    invariant forall j: nat :: ((j < i) ==> bounds(placements, j) ==> !(placements[j].openStart) ==> ((first[placements[j].row] >= 0) && (earliest[placements[j].row] <= placements[j].earliest)))
    invariant forall j: nat :: ((j < i) ==> bounds(placements, j) ==> !(placements[j].openEnd) ==> ((last[placements[j].row] >= 0) && (placements[j].latest <= latest[placements[j].row])))
    invariant forall s: nat :: ((s < rowCount) ==> (first[s] >= 0) ==> (((((first[s] < |placements|) && (placements[first[s]].row == s)) && bounds(placements, first[s])) && !(placements[first[s]].openStart)) && (placements[first[s]].earliest == earliest[s])))
    invariant forall s: nat :: ((s < rowCount) ==> (last[s] >= 0) ==> (((((last[s] < |placements|) && (placements[last[s]].row == s)) && bounds(placements, last[s])) && !(placements[last[s]].openEnd)) && (placements[last[s]].latest == latest[s])))
    invariant forall s: nat :: ((s < rowCount) ==> dated[s] ==> !(openStart[s]) ==> (first[s] >= 0))
    invariant forall s: nat :: ((s < rowCount) ==> dated[s] ==> !(openEnd[s]) ==> (last[s] >= 0))
    invariant forall s: nat :: ((s < rowCount) ==> dated[s] ==> (by_[s] >= 0))
    decreases (|placements| - i)
  {
    var p := placements[i];
    var i_t1 := placesAtHouse(p.type_, p.role);
    if i_t1 {
      var row := p.row;
      if (by_[row] < 0) {
        by_ := by_[row := i];
      }
      if p.dated {
        dated := dated[row := true];
        if p.openStart {
          openStart := openStart[row := true];
        } else if ((first[row] < 0) || (p.earliest < earliest[row])) {
          earliest := earliest[row := p.earliest];
          first := first[row := i];
        }
        if p.openEnd {
          openEnd := openEnd[row := true];
        } else if ((last[row] < 0) || (p.latest > latest[row])) {
          latest := latest[row := p.latest];
          last := last[row := i];
        }
      }
    }
    i := (i + 1);
  }
  return HouseRows(by_, dated, openStart, openEnd, earliest, latest, first, last);
}

method succession(a: seq<int>, b: seq<int>, sex: seq<string>, children: seq<RowChild>) returns (res: Succession)
  requires (|a| == |b|)
  requires forall r: nat :: ((r < |a|) ==> ((((-1 <= a[r]) && (a[r] < |sex|)) && (-1 <= b[r])) && (b[r] < |sex|)))
  ensures (|res.kind| == |a|)
  ensures (|res.from| == |a|)
  ensures (|res.through| == |a|)
  ensures (|res.marriedIn| == |a|)
  ensures forall r: nat :: ((r < |a|) ==> ((-1 <= res.from[r]) && (res.from[r] < r)))
  ensures forall r: nat :: ((r < |a|) ==> (res.from[r] >= 0) ==> linked(a, b, children, r, res.from[r]))
  ensures forall r: nat :: ((r < |a|) ==> forall j: nat :: ((j < r) ==> (j > res.from[r]) ==> !(linked(a, b, children, r, j))))
  ensures forall r: nat :: ((r < |a|) ==> ((res.from[r] < 0) == (res.kind[r] == NO_LINK)))
  ensures forall r: nat :: ((r < |a|) ==> (res.from[r] >= 0) ==> ((((res.kind[r] == SON) || (res.kind[r] == DAUGHTER)) || (res.kind[r] == CHILD)) == (isChildOf(children, a[r], res.from[r]) || isChildOf(children, b[r], res.from[r]))))
  ensures forall r: nat :: ((r < |a|) ==> (((res.kind[r] == SON) || (res.kind[r] == DAUGHTER)) || (res.kind[r] == CHILD)) ==> ((((0 <= res.through[r]) && (res.through[r] < |sex|)) && ((res.through[r] == a[r]) || (res.through[r] == b[r]))) && isChildOf(children, res.through[r], res.from[r])))
  ensures forall r: nat :: ((r < |a|) ==> (res.kind[r] == SON) ==> (sex[res.through[r]] == "male"))
  ensures forall r: nat :: ((r < |a|) ==> (res.kind[r] == DAUGHTER) ==> (sex[res.through[r]] == "female"))
  ensures forall r: nat :: ((r < |a|) ==> (res.marriedIn[r] >= 0) ==> ((((((res.kind[r] == SON) || (res.kind[r] == DAUGHTER)) || (res.kind[r] == CHILD)) && ((res.marriedIn[r] == a[r]) || (res.marriedIn[r] == b[r]))) && (res.marriedIn[r] != res.through[r])) && !(isChildBefore(children, res.marriedIn[r], r))))
  ensures forall r: nat :: ((r < |a|) ==> (((res.kind[r] == SON) || (res.kind[r] == DAUGHTER)) || (res.kind[r] == CHILD)) ==> (res.through[r] == a[r]) ==> (b[r] >= 0) ==> (b[r] != a[r]) ==> !(isChildBefore(children, b[r], r)) ==> (res.marriedIn[r] == b[r]))
  ensures forall r: nat :: ((r < |a|) ==> (((res.kind[r] == SON) || (res.kind[r] == DAUGHTER)) || (res.kind[r] == CHILD)) ==> (res.through[r] == b[r]) ==> (a[r] >= 0) ==> (a[r] != b[r]) ==> !(isChildBefore(children, a[r], r)) ==> (res.marriedIn[r] == a[r]))
  ensures forall r: nat :: ((r < |a|) ==> (res.from[r] >= 0) ==> ((res.kind[r] == REMARRIAGE) == ((!(isChildOf(children, a[r], res.from[r])) && !(isChildOf(children, b[r], res.from[r]))) && sharePartner(a, b, r, res.from[r]))))
  ensures forall r: nat :: ((r < |a|) ==> (res.kind[r] == REMARRIAGE) ==> ((0 <= res.through[r]) && ((res.through[r] == a[r]) || (res.through[r] == b[r]))))
{
  var kind: seq<int> := [];
  var from: seq<int> := [];
  var through: seq<int> := [];
  var marriedIn: seq<int> := [];
  var r := 0;
  while (r < |a|)
    invariant (0 <= r)
    invariant (r <= |a|)
    invariant (|kind| == r)
    invariant (|from| == r)
    invariant (|through| == r)
    invariant (|marriedIn| == r)
    invariant forall s: nat :: ((s < r) ==> ((-1 <= from[s]) && (from[s] < s)))
    invariant forall s: nat :: ((s < r) ==> (from[s] >= 0) ==> linked(a, b, children, s, from[s]))
    invariant forall s: nat :: ((s < r) ==> forall j: nat :: ((j < s) ==> (j > from[s]) ==> !(linked(a, b, children, s, j))))
    invariant forall s: nat :: ((s < r) ==> ((from[s] < 0) == (kind[s] == NO_LINK)))
    invariant forall s: nat :: ((s < r) ==> (from[s] >= 0) ==> ((((kind[s] == SON) || (kind[s] == DAUGHTER)) || (kind[s] == CHILD)) == (isChildOf(children, a[s], from[s]) || isChildOf(children, b[s], from[s]))))
    invariant forall s: nat :: ((s < r) ==> (((kind[s] == SON) || (kind[s] == DAUGHTER)) || (kind[s] == CHILD)) ==> ((((0 <= through[s]) && (through[s] < |sex|)) && ((through[s] == a[s]) || (through[s] == b[s]))) && isChildOf(children, through[s], from[s])))
    invariant forall s: nat :: ((s < r) ==> (kind[s] == SON) ==> (sex[through[s]] == "male"))
    invariant forall s: nat :: ((s < r) ==> (kind[s] == DAUGHTER) ==> (sex[through[s]] == "female"))
    invariant forall s: nat :: ((s < r) ==> (marriedIn[s] >= 0) ==> ((((((kind[s] == SON) || (kind[s] == DAUGHTER)) || (kind[s] == CHILD)) && ((marriedIn[s] == a[s]) || (marriedIn[s] == b[s]))) && (marriedIn[s] != through[s])) && !(isChildBefore(children, marriedIn[s], s))))
    invariant forall s: nat :: ((s < r) ==> (((kind[s] == SON) || (kind[s] == DAUGHTER)) || (kind[s] == CHILD)) ==> (through[s] == a[s]) ==> (b[s] >= 0) ==> (b[s] != a[s]) ==> !(isChildBefore(children, b[s], s)) ==> (marriedIn[s] == b[s]))
    invariant forall s: nat :: ((s < r) ==> (((kind[s] == SON) || (kind[s] == DAUGHTER)) || (kind[s] == CHILD)) ==> (through[s] == b[s]) ==> (a[s] >= 0) ==> (a[s] != b[s]) ==> !(isChildBefore(children, a[s], s)) ==> (marriedIn[s] == a[s]))
    invariant forall s: nat :: ((s < r) ==> (from[s] >= 0) ==> ((kind[s] == REMARRIAGE) == ((!(isChildOf(children, a[s], from[s])) && !(isChildOf(children, b[s], from[s]))) && sharePartner(a, b, s, from[s]))))
    invariant forall s: nat :: ((s < r) ==> (kind[s] == REMARRIAGE) ==> ((0 <= through[s]) && ((through[s] == a[s]) || (through[s] == b[s]))))
    decreases (|a| - r)
  {
    var j := (r - 1);
    while ((j >= 0) && !(linked(a, b, children, r, j)))
      invariant (-1 <= j)
      invariant (j < r)
      invariant forall k: nat :: ((k < r) ==> (k > j) ==> !(linked(a, b, children, r, k)))
      decreases (j + 1)
    {
      j := (j - 1);
    }
    var pa := a[r];
    var pb := b[r];
    var k := NO_LINK;
    var via := -1;
    var other := -1;
    if (j >= 0) {
      var i_t2 := isChildOf(children, pa, j);
      if i_t2 {
        via := pa;
        other := pb;
      } else {
        var i_t3 := isChildOf(children, pb, j);
        if i_t3 {
          via := pb;
          other := pa;
        }
      }
      if (via >= 0) {
        k := (if (sex[via] == "male") then SON else (if (sex[via] == "female") then DAUGHTER else CHILD));
      } else {
        k := REMARRIAGE;
        via := (if ((pa >= 0) && ((pa == a[j]) || (pa == b[j]))) then pa else pb);
      }
    }
    var i_t4 := isChildBefore(children, other, r);
    var married := (if ((((((k == SON) || (k == DAUGHTER)) || (k == CHILD)) && (other >= 0)) && (other != via)) && !(i_t4)) then other else -1);
    kind := (kind + [k]);
    from := (from + [j]);
    through := (through + [via]);
    marriedIn := (marriedIn + [married]);
    r := (r + 1);
  }
  return Succession(kind, from, through, marriedIn);
}
