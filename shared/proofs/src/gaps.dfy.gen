    invariant forall u: nat :: ((u < v) ==> isParentsGap(persons[u]) ==> !(anyFits(registers, "birth", persons[u].datesKnown, (persons[u].from - margin), (persons[u].to + margin), persons[u].parishIds)) ==> !((gapKey("parents", persons[u].personId, "") in decided)) ==> hasSuggestion(out, "parents", u, -1, (persons[u].from - margin), (persons[u].to + margin)))
