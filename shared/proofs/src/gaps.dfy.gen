    invariant forall u: nat :: ((u < |persons|) ==> isParentsGap(persons[u]) ==> !(anyFits(registers, "birth", persons[u].datesKnown, (persons[u].from - margin), (persons[u].to + margin), persons[u].parishIds)) ==> !((gapKey("parents", persons[u].personId, "") in decided)) ==> hasSuggestion(out, "parents", u, -1, (persons[u].from - margin), (persons[u].to + margin)))
    invariant forall u: nat, r: nat :: ((u < m) ==> (r < |registers|) ==> isMarriageGap(marriages[u]) ==> fits(registers[r], "marriage", marriages[u].datesKnown, (marriages[u].from - margin), (marriages[u].to + margin), marriages[u].parishIds) ==> !((gapKey("marriage", marriages[u].familyId, registers[r].sourceId) in decided)) ==> hasSuggestion(out, "marriage", u, r, maxInt((marriages[u].from - margin), registers[r].from), minInt((marriages[u].to + margin), registers[r].to)))
    invariant forall u: nat :: ((u < m) ==> isMarriageGap(marriages[u]) ==> !(anyFits(registers, "marriage", marriages[u].datesKnown, (marriages[u].from - margin), (marriages[u].to + margin), marriages[u].parishIds)) ==> !((gapKey("marriage", marriages[u].familyId, "") in decided)) ==> hasSuggestion(out, "marriage", u, -1, (if marriages[u].datesKnown then (marriages[u].from - margin) else 0), (if marriages[u].datesKnown then (marriages[u].to + margin) else 0)))
