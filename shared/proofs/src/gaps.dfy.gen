    invariant forall i: nat :: ((i < |out|) ==> ((isRealGap(out[i], persons, marriages, registers, margin) && (out[i].key == gapKey(out[i].kind, out[i].subjectId, out[i].sourceId))) && !((out[i].key in decided))))
    invariant forall u: nat, r: nat :: ((u < v) ==> (r < |registers|) ==> isBirthGap(persons[u]) ==> fits(registers[r], "birth", persons[u].datesKnown, (persons[u].from - margin), (persons[u].to + margin), persons[u].parishIds) ==> !((gapKey("birth", persons[u].personId, registers[r].sourceId) in decided)) ==> hasSuggestion(out, "birth", u, r, maxInt((persons[u].from - margin), registers[r].from), minInt((persons[u].to + margin), registers[r].to)))
