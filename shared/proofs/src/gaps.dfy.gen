  ensures forall v: nat :: ((v < |persons|) ==> isBirthGap(persons[v]) ==> !(anyFits(registers, "birth", persons[v].datesKnown, (persons[v].from - margin), (persons[v].to + margin), persons[v].parishIds)) ==> !((gapKey("birth", persons[v].personId, "") in decided)) ==> hasSuggestion(res, "birth", v, -1, (if persons[v].datesKnown then (persons[v].from - margin) else 0), (if persons[v].datesKnown then (persons[v].to + margin) else 0)))
