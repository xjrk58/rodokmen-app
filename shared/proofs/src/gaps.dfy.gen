// Generated by lsc from gaps.ts

datatype GapPerson = GapPerson(personId: string, relative: bool, birthCited: bool, parentsKnown: bool, datesKnown: bool, from: int, to: int, parishIds: seq<string>)

datatype GapMarriage = GapMarriage(familyId: string, relative: bool, cited: bool, datesKnown: bool, from: int, to: int, parishIds: seq<string>)

datatype Register = Register(sourceId: string, parishId: string, kind: string, from: int, to: int)

datatype GapSuggestion = GapSuggestion(kind: string, subject: int, subjectId: string, register: int, sourceId: string, key: string, from: int, to: int)

function gapKey(kind: string, subjectId: string, sourceId: string): string
{
  ((((kind + ":") + subjectId) + ":") + sourceId)
}

function maxInt(a: int, b: int): int
{
  if (a >= b) then
    a
  else
    b
}

lemma maxInt_ensures(a: int, b: int)
  ensures (maxInt(a, b) >= a)
  ensures (maxInt(a, b) >= b)
  ensures ((maxInt(a, b) == a) || (maxInt(a, b) == b))
{
}

function minInt(a: int, b: int): int
{
  if (a <= b) then
    a
  else
    b
}

lemma minInt_ensures(a: int, b: int)
  ensures (minInt(a, b) <= a)
  ensures (minInt(a, b) <= b)
  ensures ((minInt(a, b) == a) || (minInt(a, b) == b))
{
}

function isBirthGap(p: GapPerson): bool
{
  (p.relative && !(p.birthCited))
}

function isParentsGap(p: GapPerson): bool
{
  (((p.relative && !(p.parentsKnown)) && p.datesKnown) && (|p.parishIds| > 0))
}

function isMarriageGap(m: GapMarriage): bool
{
  (m.relative && !(m.cited))
}

function fits(reg: Register, kind: string, located: bool, from: int, to: int, parishIds: seq<string>): bool
{
  (((((reg.kind == kind) && located) && (reg.parishId in parishIds)) && (reg.from <= to)) && (from <= reg.to))
}

function anyFits(registers: seq<Register>, kind: string, located: bool, from: int, to: int, parishIds: seq<string>): bool
{
  (exists reg :: reg in registers && fits(reg, kind, located, from, to, parishIds))
}

function hasSuggestion(found: seq<GapSuggestion>, kind: string, subject: int, register: int, from: int, to: int): bool
{
  (exists s :: s in found && (((((s.kind == kind) && (s.subject == subject)) && (s.register == register)) && (s.from == from)) && (s.to == to)))
}

function isRealGap(s: GapSuggestion, persons: seq<GapPerson>, marriages: seq<GapMarriage>, registers: seq<Register>, margin: int): bool
{
  if ((s.kind == "birth") || (s.kind == "parents")) then
    if ((s.subject < 0) || (s.subject >= |persons|)) then
      false
    else
      var p := persons[s.subject];
      if (s.subjectId != p.personId) then
        false
      else
        if ((s.kind == "birth") && !(isBirthGap(p))) then
          false
        else
          if ((s.kind == "parents") && !(isParentsGap(p))) then
            false
          else
            if (s.register >= 0) then
              ((s.register < |registers|) && fits(registers[s.register], "birth", p.datesKnown, (p.from - margin), (p.to + margin), p.parishIds))
            else
              !(anyFits(registers, "birth", p.datesKnown, (p.from - margin), (p.to + margin), p.parishIds))
  else
    ((s.kind == "marriage") && (if ((s.subject < 0) || (s.subject >= |marriages|)) then false else (var m := marriages[s.subject]; (if ((s.subjectId != m.familyId) || !(isMarriageGap(m))) then false else (if (s.register >= 0) then ((s.register < |registers|) && fits(registers[s.register], "marriage", m.datesKnown, (m.from - margin), (m.to + margin), m.parishIds)) else !(anyFits(registers, "marriage", m.datesKnown, (m.from - margin), (m.to + margin), m.parishIds)))))))
}

method gapSuggestions(kind: string, subject: int, subjectId: string, registerKind: string, located: bool, from: int, to: int, parishIds: seq<string>, registers: seq<Register>, decided: seq<string>) returns (res: seq<GapSuggestion>)
  ensures forall i: nat :: ((i < |res|) ==> (((res[i].kind == kind) && (res[i].subject == subject)) && (res[i].subjectId == subjectId)))
  ensures forall i: nat :: ((i < |res|) ==> ((res[i].key == gapKey(kind, subjectId, res[i].sourceId)) && !((res[i].key in decided))))
  ensures forall i: nat :: ((i < |res|) ==> (res[i].register >= 0) ==> (((((res[i].register < |registers|) && fits(registers[res[i].register], registerKind, located, from, to, parishIds)) && (res[i].sourceId == registers[res[i].register].sourceId)) && (res[i].from == maxInt(from, registers[res[i].register].from))) && (res[i].to == minInt(to, registers[res[i].register].to))))
  ensures forall i: nat :: ((i < |res|) ==> (res[i].register < 0) ==> (((res[i].register == -1) && (res[i].sourceId == "")) && !(anyFits(registers, registerKind, located, from, to, parishIds))))
  ensures forall r: nat :: ((r < |registers|) ==> fits(registers[r], registerKind, located, from, to, parishIds) ==> !((gapKey(kind, subjectId, registers[r].sourceId) in decided)) ==> hasSuggestion(res, kind, subject, r, maxInt(from, registers[r].from), minInt(to, registers[r].to)))
  ensures (!(anyFits(registers, registerKind, located, from, to, parishIds)) ==> !((gapKey(kind, subjectId, "") in decided)) ==> hasSuggestion(res, kind, subject, -1, (if located then from else 0), (if located then to else 0)))
{
  var out: seq<GapSuggestion> := [];
  var fitting := false;
  var r := 0;
  while (r < |registers|)
    invariant (0 <= r)
    invariant (r <= |registers|)
    invariant (fitting == exists j: nat :: ((j < r) && fits(registers[j], registerKind, located, from, to, parishIds)))
    invariant forall i: nat :: ((i < |out|) ==> (((out[i].kind == kind) && (out[i].subject == subject)) && (out[i].subjectId == subjectId)))
    invariant forall i: nat :: ((i < |out|) ==> ((out[i].key == gapKey(kind, subjectId, out[i].sourceId)) && !((out[i].key in decided))))
    invariant forall i: nat :: ((i < |out|) ==> ((((((0 <= out[i].register) && (out[i].register < r)) && fits(registers[out[i].register], registerKind, located, from, to, parishIds)) && (out[i].sourceId == registers[out[i].register].sourceId)) && (out[i].from == maxInt(from, registers[out[i].register].from))) && (out[i].to == minInt(to, registers[out[i].register].to))))
    invariant forall q: nat :: ((q < r) ==> fits(registers[q], registerKind, located, from, to, parishIds) ==> !((gapKey(kind, subjectId, registers[q].sourceId) in decided)) ==> hasSuggestion(out, kind, subject, q, maxInt(from, registers[q].from), minInt(to, registers[q].to)))
    decreases (|registers| - r)
  {
    var reg := registers[r];
    var i_t0 := fits(reg, registerKind, located, from, to, parishIds);
    if i_t0 {
      fitting := true;
      var i_t1 := gapKey(kind, subjectId, reg.sourceId);
      var key := i_t1;
      if !((key in decided)) {
        var i_t2 := maxInt(from, reg.from);
        var i_t3 := minInt(to, reg.to);
        out := (out + [GapSuggestion(kind, subject, subjectId, r, reg.sourceId, key, i_t2, i_t3)]);
      }
    }
    r := (r + 1);
  }
  if !(fitting) {
    var i_t4 := gapKey(kind, subjectId, "");
    var key := i_t4;
    if !((key in decided)) {
      out := (out + [GapSuggestion(kind, subject, subjectId, -1, "", key, (if located then from else 0), (if located then to else 0))]);
    }
  }
  return out;
}

method suggestGaps(persons: seq<GapPerson>, marriages: seq<GapMarriage>, registers: seq<Register>, decided: seq<string>, margin: int) returns (res: seq<GapSuggestion>)
  ensures forall i: nat :: ((i < |res|) ==> isRealGap(res[i], persons, marriages, registers, margin))
