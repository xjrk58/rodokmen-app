// Generated by lsc from matching.ts

datatype ReadFacts = ReadFacts(givens: seq<string>, surnames: seq<string>, house: string, placeId: string, hasWindow: bool, windowFrom: int, windowTo: int)

datatype CandidateFacts = CandidateFacts(givens: seq<string>, surnames: seq<string>, houses: seq<string>, placeIds: seq<string>, hasBirth: bool, birthFrom: int, birthTo: int, family: bool)

datatype MatchFlags = MatchFlags(name: bool, house: bool, years: bool, place: bool, family: bool)

datatype MatchScore = MatchScore(score: int, reasons: MatchFlags)

function sharesOne(a: seq<string>, b: seq<string>): bool
{
  (exists x :: x in a && (x in b))
}

function nameMatches(read: ReadFacts, c: CandidateFacts): bool
{
  (sharesOne(read.givens, c.givens) && sharesOne(read.surnames, c.surnames))
}

function houseMatches(read: ReadFacts, c: CandidateFacts): bool
{
  ((read.house != "") && (read.house in c.houses))
}

function yearsMatch(read: ReadFacts, c: CandidateFacts): bool
{
  (((read.hasWindow && c.hasBirth) && (c.birthFrom <= read.windowTo)) && (read.windowFrom <= c.birthTo))
}

function placeMatches(read: ReadFacts, c: CandidateFacts): bool
{
  ((read.placeId != "") && (read.placeId in c.placeIds))
}

function matchReasons(read: ReadFacts, c: CandidateFacts): MatchFlags
{
  MatchFlags(nameMatches(read, c), houseMatches(read, c), yearsMatch(read, c), placeMatches(read, c), c.family)
}

function scoreOf(r: MatchFlags): int
{
  (((((if r.name then 16 else 0) + (if r.house then 8 else 0)) + (if r.years then 4 else 0)) + (if r.place then 1 else 0)) + (if r.family then 1 else 0))
}

lemma scoreOf_ensures(r: MatchFlags)
  ensures (scoreOf(r) >= 0)
  ensures (scoreOf(r) <= 30)
{
}

function fullMatch(read: ReadFacts, c: CandidateFacts): bool
{
  ((nameMatches(read, c) && houseMatches(read, c)) && yearsMatch(read, c))
}

function scoreCandidate(read: ReadFacts, c: CandidateFacts): MatchScore
{
  var reasons := matchReasons(read, c);
  MatchScore(scoreOf(reasons), reasons)
}

lemma scoreCandidate_ensures(read: ReadFacts, c: CandidateFacts)
  ensures (scoreCandidate(read, c).reasons == matchReasons(read, c))
  ensures (scoreCandidate(read, c).score == scoreOf(matchReasons(read, c)))
{
}

function ranksAbove(read: ReadFacts, a: CandidateFacts, b: CandidateFacts): bool
{
  (scoreCandidate(read, a).score > scoreCandidate(read, b).score)
}

lemma ranksAbove_ensures(read: ReadFacts, a: CandidateFacts, b: CandidateFacts)
  ensures (fullMatch(read, a) ==> !(fullMatch(read, b)) ==> ranksAbove(read, a, b))
  ensures (ranksAbove(read, a, b) == (scoreCandidate(read, a).score > scoreCandidate(read, b).score))
{
}

function isSuggested(read: ReadFacts, c: CandidateFacts): bool
{
  nameMatches(read, c)
}

lemma isSuggested_ensures(read: ReadFacts, c: CandidateFacts)
  ensures (isSuggested(read, c) == nameMatches(read, c))
{
}
