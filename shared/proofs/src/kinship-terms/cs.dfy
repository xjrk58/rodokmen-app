function csBirthWord(up: int, down: int): int
  requires (up >= 0)
  requires (down >= 0)
{
  if ((up == 0) && (down == 0)) then
    CS_SELF
  else
    if (down == 0) then
      if (up == 1) then
        CS_PARENT
      else
        if (up <= (2 + MAX_PRA)) then
          CS_GRANDPARENT
        else
          CS_ANCESTOR
    else
      if (up == 0) then
        if (down == 1) then
          CS_CHILD
        else
          if (down <= (2 + MAX_PRA)) then
            CS_GRANDCHILD
          else
            CS_DESCENDANT
      else
        if (up == down) then
          if (up == 1) then
            CS_SIBLING
          else
            CS_COUSIN
        else
          if (up > down) then
            if (((up - down) - 1) <= MAX_PRA) then
              CS_UNCLE
            else
              CS_RELATIVE
          else
            if (((down - up) - 1) <= MAX_PRA) then
              CS_NEPHEW
            else
              CS_RELATIVE
}

function csPra(word: int, up: int, down: int): int
{
  if (word == CS_GRANDPARENT) then
    (up - 2)
  else
    if (word == CS_GRANDCHILD) then
      (down - 2)
    else
      if (word == CS_UNCLE) then
        ((up - down) - 1)
      else
        if (word == CS_NEPHEW) then
          ((down - up) - 1)
        else
          0
}

function csKoleno(word: int, up: int, down: int): int
{
  if ((word == CS_UNCLE) && (down >= 2)) then
    down
  else
    if ((word == CS_NEPHEW) && (up >= 2)) then
      up
    else
      if ((word == CS_COUSIN) && (up >= 3)) then
        (up - 1)
      else
        0
}

function csPartnerKinWord(up: int, down: int): int
{
  if ((up == 1) && (down == 0)) then
    CS_PARENT_IN_LAW
  else
    if ((up == 1) && (down == 1)) then
      CS_SIBLING_IN_LAW
    else
      if ((up == 0) && (down == 1)) then
        CS_STEPCHILD
      else
        CS_AFFINE
}

function csKinPartnerWord(up: int, down: int): int
{
  if ((up == 0) && (down == 1)) then
    CS_CHILD_IN_LAW
  else
    if ((up == 1) && (down == 1)) then
      CS_SIBLING_IN_LAW
    else
      if ((up == 1) && (down == 0)) then
        CS_STEPPARENT
      else
        if ((up == 2) && (down == 0)) then
          CS_STEP_GRANDPARENT
        else
          if ((up == 2) && (down == 1)) then
            CS_UNCLE_BY_MARRIAGE
          else
            CS_AFFINE
}

function csWord(t: TermInput): int
  requires (t.up >= 0)
  requires (t.down >= 0)
{
  if (t.shape == SHAPE_BIRTH) then
    csBirthWord(t.up, t.down)
  else
    if (t.shape == SHAPE_PARTNER) then
      if t.married then
        CS_SPOUSE
      else
        CS_PARTNER
    else
      if (t.shape == SHAPE_PARTNER_KIN) then
        csPartnerKinWord(t.up, t.down)
      else
        if (t.shape == SHAPE_KIN_PARTNER) then
          csKinPartnerWord(t.up, t.down)
        else
          if (t.shape == SHAPE_STEP_SIBLING) then
            CS_STEP_SIBLING
          else
            if (t.shape == SHAPE_CO_PARENT_IN_LAW) then
              CS_CO_PARENT_IN_LAW
            else
              if (t.shape == SHAPE_FOSTER) then
                if (t.up >= 1) then
                  CS_FOSTER_PARENT
                else
                  CS_FOSTER_CHILD
              else
                CS_SELF
}

function csNeutralGender(word: int): int
{
  if ((((word == CS_CHILD) || (word == CS_GRANDCHILD)) || (word == CS_STEPCHILD)) || (word == CS_FOSTER_CHILD)) then
    NEUTER
  else
    if (((((word == CS_SELF) || (word == CS_PARENT)) || (word == CS_GRANDPARENT)) || (word == CS_ANCESTOR)) || (word == CS_DESCENDANT)) then
      MASCULINE
    else
      if ((((word == CS_SIBLING) || (word == CS_STEPPARENT)) || (word == CS_STEP_GRANDPARENT)) || (word == CS_STEP_SIBLING)) then
        MASCULINE
      else
        COMBINED
}

function csAdoptive(t: TermInput): int
{
  if (((!(t.adoptive) || (t.shape == SHAPE_SELF)) || (t.shape == SHAPE_PARTNER)) || (t.shape == SHAPE_FOSTER)) then
    NOT_ADOPTIVE
  else
    if ((t.shape == SHAPE_BIRTH) && ((t.up + t.down) == 1)) then
      ADOPTIVE_WORD
    else
      THROUGH_ADOPTION
}

function termCs(t: TermInput): CsTerm
  requires (t.up >= 0)
  requires (t.down >= 0)
{
  var word := csWord(t);
  var gender := (if (t.sex == MALE) then MASCULINE else (if (t.sex == FEMALE) then FEMININE else csNeutralGender(word)));
  var form := (if (t.sex == MALE) then MALE_FORM else (if (t.sex == FEMALE) then FEMALE_FORM else (if (gender == COMBINED) then BOTH_FORMS else NEUTRAL_FORM)));
  CsTerm(word, form, (if (t.shape == SHAPE_BIRTH) then csPra(word, t.up, t.down) else 0), (if (t.shape == SHAPE_BIRTH) then csKoleno(word, t.up, t.down) else 0), (if (word == CS_ANCESTOR) then t.up else (if (word == CS_DESCENDANT) then t.down else 0)), ((t.shape == SHAPE_BIRTH) && t.half), csAdoptive(t), gender)
}

