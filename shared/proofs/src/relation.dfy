// Generated by lsc from relation.ts

datatype FamilyLink = FamilyLink(a: int, b: int, confidences: seq<string>)

datatype Reach = Reach(reached: seq<bool>, via: seq<int>, order: seq<int>)

function isConfirming(confidence: string): bool
{
  (((confidence == "normal") || (confidence == "high")) || (confidence == "very_high"))
}

lemma isConfirming_ensures(confidence: string)
  ensures ((((confidence == "normal") || (confidence == "high")) || (confidence == "very_high")) ==> isConfirming(confidence))
  ensures (((confidence == "low") || (confidence == "very_low")) ==> !(isConfirming(confidence)))
{
}

function isStrongLink(link: FamilyLink): bool
{
  (exists c :: c in link.confidences && isConfirming(c))
}

function mayFollow(link: FamilyLink, strongOnly: bool): bool
{
  (!(strongOnly) || isStrongLink(link))
}

function isSupported(r: Reach, links: seq<FamilyLink>, strongOnly: bool, v: int): bool
  requires (0 <= v)
  requires (v < |r.reached|)
  requires (|r.reached| == |r.via|)
  requires (|r.reached| == |r.order|)
  requires forall i: nat :: ((i < |links|) ==> ((((0 <= links[i].a) && (links[i].a < |r.reached|)) && (0 <= links[i].b)) && (links[i].b < |r.reached|)))
{
  var i := r.via[v];
  if ((i < 0) || (i >= |links|)) then
    false
  else
    var l := links[i];
    if !(mayFollow(l, strongOnly)) then
      false
    else
      if (l.b == v) then
        (r.reached[l.a] && (r.order[l.a] < r.order[v]))
      else
        ((l.a == v) && (r.reached[l.b] && (r.order[l.b] < r.order[v])))
}

const UNRELATED: int := 0

const POSSIBLE: int := 1

const RELATIVE: int := 2

method reachFrom(count: int, isStart: seq<bool>, links: seq<FamilyLink>, strongOnly: bool) returns (res: Reach)
  requires (|isStart| == count)
  requires forall i: nat :: ((i < |links|) ==> ((((0 <= links[i].a) && (links[i].a < count)) && (0 <= links[i].b)) && (links[i].b < count)))
  ensures (|res.reached| == count)
  ensures (|res.via| == count)
  ensures (|res.order| == count)
  ensures forall v: nat :: ((v < count) ==> isStart[v] ==> res.reached[v])
  ensures forall i: nat :: ((i < |links|) ==> mayFollow(links[i], strongOnly) ==> res.reached[links[i].a] ==> res.reached[links[i].b])
  ensures forall i: nat :: ((i < |links|) ==> mayFollow(links[i], strongOnly) ==> res.reached[links[i].b] ==> res.reached[links[i].a])
  ensures forall v: nat :: ((v < count) ==> res.reached[v] ==> !(isStart[v]) ==> isSupported(res, links, strongOnly, v))
  ensures forall v: nat :: ((v < count) ==> (res.order[v] >= 0))
  ensures ((forall v: nat :: ((v < count) ==> !(isStart[v]))) ==> forall v: nat :: ((v < count) ==> !(res.reached[v])))
{
  var reached: seq<bool> := [];
  var via: seq<int> := [];
  var order: seq<int> := [];
  var i_start_idx := 0;
  while i_start_idx < |isStart|
    invariant (i_start_idx <= |isStart|)
    invariant (|reached| == i_start_idx)
    invariant (|via| == i_start_idx)
    invariant (|order| == i_start_idx)
    invariant forall v: nat :: ((v < i_start_idx) ==> (((reached[v] == isStart[v]) && (via[v] == -1)) && (order[v] == 0)))
  {
    var start := isStart[i_start_idx];
    reached := (reached + [start]);
    via := (via + [-1]);
    order := (order + [0]);
    i_start_idx := i_start_idx + 1;
  }
  var step := 1;
  var changed := true;
  while changed
    invariant (|reached| == count)
    invariant (|via| == count)
    invariant (|order| == count)
    invariant (step >= 1)
    invariant forall v: nat :: ((v < count) ==> isStart[v] ==> reached[v])
    invariant forall v: nat :: ((v < count) ==> ((0 <= order[v]) && (order[v] < step)))
    invariant forall v: nat :: ((v < count) ==> reached[v] ==> !(isStart[v]) ==> isSupported(Reach(reached, via, order), links, strongOnly, v))
    invariant ((forall v: nat :: ((v < count) ==> !(isStart[v]))) ==> forall v: nat :: ((v < count) ==> !(reached[v])))
    invariant (!(changed) ==> forall i: nat :: ((i < |links|) ==> mayFollow(links[i], strongOnly) ==> reached[links[i].a] ==> reached[links[i].b]))
    invariant (!(changed) ==> forall i: nat :: ((i < |links|) ==> mayFollow(links[i], strongOnly) ==> reached[links[i].b] ==> reached[links[i].a]))
    // Proof addition: a round that reaches someone new leaves fewer unreached, and the last round reaches nobody.
    decreases multiset(reached)[false], changed
  {
    ghost var unreached := multiset(reached)[false];
    changed := false;
    var i := 0;
    while (i < |links|)
      invariant (0 <= i)
      invariant (i <= |links|)
      invariant (|reached| == count)
      invariant (|via| == count)
      invariant (|order| == count)
      invariant (step >= 1)
      invariant forall v: nat :: ((v < count) ==> isStart[v] ==> reached[v])
      invariant forall v: nat :: ((v < count) ==> ((0 <= order[v]) && (order[v] < step)))
      invariant forall v: nat :: ((v < count) ==> reached[v] ==> !(isStart[v]) ==> isSupported(Reach(reached, via, order), links, strongOnly, v))
      invariant ((forall v: nat :: ((v < count) ==> !(isStart[v]))) ==> forall v: nat :: ((v < count) ==> !(reached[v])))
      invariant (!(changed) ==> forall j: nat :: ((j < i) ==> mayFollow(links[j], strongOnly) ==> reached[links[j].a] ==> reached[links[j].b]))
      invariant (!(changed) ==> forall j: nat :: ((j < i) ==> mayFollow(links[j], strongOnly) ==> reached[links[j].b] ==> reached[links[j].a]))
      // Proof addition: how many are still unreached in this round.
      invariant multiset(reached)[false] <= unreached && (changed ==> multiset(reached)[false] < unreached)
      decreases (|links| - i)
    {
      var l := links[i];
      var i_t0 := mayFollow(l, strongOnly);
      if i_t0 {
        if (reached[l.a] && !(reached[l.b])) {
          reached := reached[l.b := true];
          via := via[l.b := i];
          order := order[l.b := step];
          step := (step + 1);
          changed := true;
        } else if (reached[l.b] && !(reached[l.a])) {
          reached := reached[l.a := true];
          via := via[l.a := i];
          order := order[l.a := step];
          step := (step + 1);
          changed := true;
        }
      }
      i := (i + 1);
    }
  }
  return Reach(reached, via, order);
}

method relationLevels(count: int, isRoot: seq<bool>, links: seq<FamilyLink>) returns (res: seq<int>)
  requires (|isRoot| == count)
  requires forall i: nat :: ((i < |links|) ==> ((((0 <= links[i].a) && (links[i].a < count)) && (0 <= links[i].b)) && (links[i].b < count)))
  ensures (|res| == count)
  ensures forall v: nat :: ((v < count) ==> (((res[v] == RELATIVE) || (res[v] == POSSIBLE)) || (res[v] == UNRELATED)))
  ensures forall v: nat :: ((v < count) ==> isRoot[v] ==> (res[v] == RELATIVE))
  ensures ((forall v: nat :: ((v < count) ==> !(isRoot[v]))) ==> forall v: nat :: ((v < count) ==> (res[v] == UNRELATED)))
  ensures forall i: nat :: ((i < |links|) ==> (exists j: nat :: ((j < |links[i].confidences|) && (((links[i].confidences[j] == "normal") || (links[i].confidences[j] == "high")) || (links[i].confidences[j] == "very_high")))) ==> (res[links[i].a] == RELATIVE) ==> (res[links[i].b] == RELATIVE))
  ensures forall i: nat :: ((i < |links|) ==> (exists j: nat :: ((j < |links[i].confidences|) && (((links[i].confidences[j] == "normal") || (links[i].confidences[j] == "high")) || (links[i].confidences[j] == "very_high")))) ==> (res[links[i].b] == RELATIVE) ==> (res[links[i].a] == RELATIVE))
  ensures forall i: nat :: ((i < |links|) ==> (res[links[i].a] != UNRELATED) ==> (res[links[i].b] != UNRELATED))
  ensures forall i: nat :: ((i < |links|) ==> (res[links[i].b] != UNRELATED) ==> (res[links[i].a] != UNRELATED))
  ensures forall v: nat :: ((v < count) ==> !(isRoot[v]) ==> (forall i: nat :: ((i < |links|) ==> ((links[i].a == v) || (links[i].b == v)) ==> forall j: nat :: ((j < |links[i].confidences|) ==> ((links[i].confidences[j] == "low") || (links[i].confidences[j] == "very_low"))))) ==> (res[v] != RELATIVE))
  ensures forall v: nat :: ((v < count) ==> !(isRoot[v]) ==> (forall i: nat :: ((i < |links|) ==> ((links[i].a != v) && (links[i].b != v)))) ==> (res[v] == UNRELATED))
{
  var i_t1 := reachFrom(count, isRoot, links, true);
  var strong := i_t1;
  var i_t2 := reachFrom(count, strong.reached, links, false);
  var any := i_t2;
  // Proof addition: both searches are certified and closed, so ReachedIsLeast and EvidenceOnlyAdds (below) apply to them.
  assert Certified(count, isRoot, links, true, strong) && ClosedFrom(count, isRoot, links, true, strong.reached);
  assert Certified(count, strong.reached, links, false, any) && ClosedFrom(count, strong.reached, links, false, any.reached);
  var levels: seq<int> := [];
  var v := 0;
  while (v < count)
    invariant (0 <= v)
    invariant (v <= count)
    invariant (|levels| == v)
    invariant forall u: nat :: ((u < v) ==> (levels[u] == (if strong.reached[u] then RELATIVE else (if any.reached[u] then POSSIBLE else UNRELATED))))
    decreases (count - v)
  {
    levels := (levels + [(if strong.reached[v] then RELATIVE else (if any.reached[v] then POSSIBLE else UNRELATED))]);
    v := (v + 1);
  }
  // Proof addition: a Citation of normal or higher confidence makes its link strong.
  forall i: nat | i < |links| && (exists j: nat :: j < |links[i].confidences| && (links[i].confidences[j] == "normal" || links[i].confidences[j] == "high" || links[i].confidences[j] == "very_high"))
    ensures isStrongLink(links[i])
  {
    var j: nat :| j < |links[i].confidences| && (links[i].confidences[j] == "normal" || links[i].confidences[j] == "high" || links[i].confidences[j] == "very_high");
    assert links[i].confidences[j] in links[i].confidences && isConfirming(links[i].confidences[j]);
  }
  return levels;
}

// ---- Proof additions: what reachFrom's postconditions mean.

// A search's result is a certificate (isSupported, order). Whoever it reached is in every set that
// holds the starts and is closed under the links the search may follow: the result is the least
// such set, so it reaches no one without a chain of such links from a start.
predicate Certified(count: int, isStart: seq<bool>, links: seq<FamilyLink>, strongOnly: bool, r: Reach)
{
  |isStart| == count && |r.reached| == count && |r.via| == count && |r.order| == count &&
  (forall i: nat :: i < |links| ==> 0 <= links[i].a < count && 0 <= links[i].b < count) &&
  (forall u: nat :: u < count ==> r.order[u] >= 0) &&
  (forall u: nat :: u < count && r.reached[u] && !isStart[u] ==> isSupported(r, links, strongOnly, u))
}

predicate ClosedFrom(count: int, isStart: seq<bool>, links: seq<FamilyLink>, strongOnly: bool, s: seq<bool>)
  requires |isStart| == count && |s| == count
  requires forall i: nat :: i < |links| ==> 0 <= links[i].a < count && 0 <= links[i].b < count
{
  (forall u: nat :: u < count && isStart[u] ==> s[u]) &&
  (forall i: nat :: i < |links| && mayFollow(links[i], strongOnly) && s[links[i].a] ==> s[links[i].b]) &&
  (forall i: nat :: i < |links| && mayFollow(links[i], strongOnly) && s[links[i].b] ==> s[links[i].a])
}

lemma ReachedIsLeast(count: int, isStart: seq<bool>, links: seq<FamilyLink>, strongOnly: bool, r: Reach, s: seq<bool>, v: nat)
  requires Certified(count, isStart, links, strongOnly, r)
  requires |s| == count && ClosedFrom(count, isStart, links, strongOnly, s)
  requires v < count && r.reached[v]
  ensures s[v]
  decreases r.order[v]
{
  if !isStart[v] {
    assert isSupported(r, links, strongOnly, v);
    var l := links[r.via[v]];
    var u := if l.b == v then l.a else l.b;
    ReachedIsLeast(count, isStart, links, strongOnly, r, s, u);
  }
}

// "Relation follows the evidence": with the same Persons, starts and links, where every link the
// search may follow before it may still follow after (a Citation added, a confidence raised),
// whoever a search reached before, it reaches after.
lemma EvidenceOnlyAdds(count: int, isStart: seq<bool>, before: seq<FamilyLink>, after: seq<FamilyLink>, strongOnly: bool, r1: Reach, r2: Reach, v: nat)
  requires Certified(count, isStart, before, strongOnly, r1)
  requires |after| == |before| && forall i: nat :: i < |before| ==> after[i].a == before[i].a && after[i].b == before[i].b
  requires forall i: nat :: i < |before| && mayFollow(before[i], strongOnly) ==> mayFollow(after[i], strongOnly)
  requires |r2.reached| == count && ClosedFrom(count, isStart, after, strongOnly, r2.reached)
  requires v < count && r1.reached[v]
  ensures r2.reached[v]
{
  assert ClosedFrom(count, isStart, before, strongOnly, r2.reached);
  ReachedIsLeast(count, isStart, before, strongOnly, r1, r2.reached, v);
}

// A Citation of normal or higher confidence added to a link never makes it weaker.
lemma CitationAddedKeepsStrength(link: FamilyLink, confidence: string)
  ensures isStrongLink(link) ==> isStrongLink(FamilyLink(link.a, link.b, link.confidences + [confidence]))
  ensures isConfirming(confidence) ==> isStrongLink(FamilyLink(link.a, link.b, link.confidences + [confidence]))
{
  var more := link.confidences + [confidence];
  assert forall c :: c in link.confidences ==> c in more;
  assert confidence in more;
}
