// Generated by lsc from reading.ts

datatype ReadDecision = ReadDecision(allowed: bool, reason: string)

datatype ScanRequest = ScanRequest(uploadId: string, crop: bool)

datatype ImageToSend = ImageToSend(uploadId: string, copy: string)

function mayRead(enabled: bool, usedToday: int, dailyLimit: int): ReadDecision
{
  if !(enabled) then
    ReadDecision(false, "off")
  else
    if (usedToday >= dailyLimit) then
      ReadDecision(false, "limit")
    else
      ReadDecision(true, "ok")
}

lemma mayRead_ensures(enabled: bool, usedToday: int, dailyLimit: int)
  ensures (!(enabled) ==> (!(mayRead(enabled, usedToday, dailyLimit).allowed) && (mayRead(enabled, usedToday, dailyLimit).reason == "off")))
  ensures (enabled ==> (usedToday >= dailyLimit) ==> (!(mayRead(enabled, usedToday, dailyLimit).allowed) && (mayRead(enabled, usedToday, dailyLimit).reason == "limit")))
  ensures (enabled ==> (usedToday < dailyLimit) ==> (mayRead(enabled, usedToday, dailyLimit).allowed && (mayRead(enabled, usedToday, dailyLimit).reason == "ok")))
  ensures (mayRead(enabled, usedToday, dailyLimit).allowed ==> (enabled && (usedToday < dailyLimit)))
{
}

function copyToSend(r: ScanRequest): ImageToSend
{
  ImageToSend(r.uploadId, (if r.crop then "crop" else "display"))
}

lemma copyToSend_ensures(r: ScanRequest)
  ensures (copyToSend(r).uploadId == r.uploadId)
  ensures ((copyToSend(r).copy == "crop") || (copyToSend(r).copy == "display"))
  ensures (r.crop ==> (copyToSend(r).copy == "crop"))
  ensures (!(r.crop) ==> (copyToSend(r).copy == "display"))
{
}

function capConfidence(confidence: string, readerDrafted: bool): string
{
  if !(readerDrafted) then
    confidence
  else
    if ((confidence == "very_low") || (confidence == "low")) then
      confidence
    else
      "normal"
}

lemma capConfidence_ensures(confidence: string, readerDrafted: bool)
  ensures (readerDrafted ==> (((capConfidence(confidence, readerDrafted) == "very_low") || (capConfidence(confidence, readerDrafted) == "low")) || (capConfidence(confidence, readerDrafted) == "normal")))
  ensures (readerDrafted ==> ((confidence == "high") || (confidence == "very_high")) ==> (capConfidence(confidence, readerDrafted) == "normal"))
  ensures (readerDrafted ==> (((confidence == "very_low") || (confidence == "low")) || (confidence == "normal")) ==> (capConfidence(confidence, readerDrafted) == confidence))
  ensures (!(readerDrafted) ==> (capConfidence(confidence, readerDrafted) == confidence))
{
}

function stillReadByAi(fromReader: bool, confirmed: bool, changed: bool): bool
{
  ((fromReader && !(confirmed)) && !(changed))
}

lemma stillReadByAi_ensures(fromReader: bool, confirmed: bool, changed: bool)
  ensures (changed ==> !(stillReadByAi(fromReader, confirmed, changed)))
  ensures (confirmed ==> !(stillReadByAi(fromReader, confirmed, changed)))
  ensures (fromReader ==> !(confirmed) ==> !(changed) ==> stillReadByAi(fromReader, confirmed, changed))
  ensures (!(fromReader) ==> !(stillReadByAi(fromReader, confirmed, changed)))
{
}

method imagesToSend(enabled: bool, requested: seq<ScanRequest>) returns (res: seq<ImageToSend>)
  ensures (!(enabled) ==> (|res| == 0))
  ensures (enabled ==> (|res| == |requested|))
  ensures forall i: nat :: ((i < |res|) ==> (res[i].uploadId == requested[i].uploadId))
  ensures forall i: nat :: ((i < |res|) ==> requested[i].crop ==> (res[i].copy == "crop"))
  ensures forall i: nat :: ((i < |res|) ==> !(requested[i].crop) ==> (res[i].copy == "display"))
  ensures forall i: nat :: ((i < |res|) ==> (res[i].copy != "original"))
{
  if !(enabled) {
    return [];
  }
  var out: seq<ImageToSend> := [];
  var i_r_idx := 0;
  while i_r_idx < |requested|
    invariant (i_r_idx <= |requested|)
    invariant (|out| == i_r_idx)
    invariant forall j: nat :: ((j < |out|) ==> (out[j] == copyToSend(requested[j])))
  {
    var r := requested[i_r_idx];
    var i_t0 := copyToSend(r);
    out := (out + [i_t0]);
    i_r_idx := i_r_idx + 1;
  }
  return out;
}
