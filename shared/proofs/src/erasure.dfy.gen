// Generated by lsc from erasure.ts

datatype SharedRecord = SharedRecord(id: string, persons: seq<string>)

datatype OwnedRow = OwnedRow(table: string, id: string, personId: string)

datatype AttachedCitation = AttachedCitation(id: string, attachedTo: seq<string>)

datatype LogItem = LogItem(id: string, mentions: seq<string>, data: string, erased: bool, at: string)

function mayErase(living: bool, confirmation: string, name: string): bool
{
  ((living && (name != "")) && (confirmation == name))
}

lemma mayErase_ensures(living: bool, confirmation: string, name: string)
  ensures (!(living) ==> !(mayErase(living, confirmation, name)))
  ensures (mayErase(living, confirmation, name) == ((living && (name != "")) && (confirmation == name)))
{
}

function onlyTheirs(r: SharedRecord, personId: string): bool
{
  ((|r.persons| > 0) && Std.Collections.Seq.All(r.persons, (p: string) => (p == personId)))
}

function leftWithNothing(c: AttachedCitation, removed: seq<string>): bool
{
  ((|c.attachedTo| > 0) && !((exists a :: a in c.attachedTo && !((a in removed)))))
}

function mentionsAny(item: LogItem, erased: seq<string>): bool
{
  (exists m :: m in item.mentions && (m in erased))
}

method theirsAlone(records: seq<SharedRecord>, personId: string) returns (res: seq<SharedRecord>)
  ensures forall j: nat :: ((j < |records|) ==> onlyTheirs(records[j], personId) ==> (records[j] in res))
  ensures forall i: nat :: ((i < |res|) ==> (onlyTheirs(res[i], personId) && (res[i] in records)))
  ensures forall i: nat :: ((i < |res|) ==> forall k: nat :: ((k < |res[i].persons|) ==> (res[i].persons[k] == personId)))
{
  var out: seq<SharedRecord> := [];
  var i_r_idx := 0;
  while i_r_idx < |records|
    invariant (i_r_idx <= |records|)
    invariant forall j: nat :: ((j < i_r_idx) ==> onlyTheirs(records[j], personId) ==> (records[j] in out))
    invariant forall i: nat :: ((i < |out|) ==> (onlyTheirs(out[i], personId) && (out[i] in records)))
    invariant forall i: nat :: ((i < |out|) ==> forall k: nat :: ((k < |out[i].persons|) ==> (out[i].persons[k] == personId)))
  {
    var r := records[i_r_idx];
    var i_t0 := onlyTheirs(r, personId);
    if i_t0 {
      out := (out + [r]);
    }
    i_r_idx := i_r_idx + 1;
  }
  return out;
}

