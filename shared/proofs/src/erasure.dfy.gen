method rewriteLog(items: seq<LogItem>, erased: seq<string>, at: string) returns (res: seq<LogItem>)
  ensures (|res| == |items|)
  ensures forall i: nat :: ((i < |items|) ==> mentionsAny(items[i], erased) ==> (((((res[i].id == items[i].id) && res[i].erased) && (res[i].at == at)) && (|res[i].mentions| == 0)) && (res[i].data == "")))
  ensures forall i: nat :: ((i < |items|) ==> !(mentionsAny(items[i], erased)) ==> (res[i] == items[i]))
{
  var out: seq<LogItem> := [];
  var i_item_idx := 0;
  while i_item_idx < |items|
    invariant (i_item_idx <= |items|)
    invariant (|out| == i_item_idx)
    invariant forall i: nat :: ((i < |out|) ==> mentionsAny(items[i], erased) ==> (((((out[i].id == items[i].id) && out[i].erased) && (out[i].at == at)) && (|out[i].mentions| == 0)) && (out[i].data == "")))
    invariant forall i: nat :: ((i < |out|) ==> !(mentionsAny(items[i], erased)) ==> (out[i] == items[i]))
  {
    var item := items[i_item_idx];
    var i_t2 := mentionsAny(item, erased);
    if i_t2 {
      out := (out + [LogItem(item.id, [], "", true, at)]);
    } else {
      out := (out + [item]);
    }
    i_item_idx := i_item_idx + 1;
  }
  return out;
}

method toEraseAgain(present: seq<string>, erasures: seq<string>) returns (res: seq<string>)
  ensures forall j: nat :: ((j < |present|) ==> (present[j] in erasures) ==> (present[j] in res))
  ensures forall i: nat :: ((i < |res|) ==> ((res[i] in erasures) && (res[i] in present)))
{
  var out: seq<string> := [];
  var i_id_idx := 0;
  while i_id_idx < |present|
    invariant (i_id_idx <= |present|)
    invariant forall j: nat :: ((j < i_id_idx) ==> (present[j] in erasures) ==> (present[j] in out))
    invariant forall i: nat :: ((i < |out|) ==> ((out[i] in erasures) && (out[i] in present)))
  {
    var id := present[i_id_idx];
    if (id in erasures) {
      out := (out + [id]);
    }
    i_id_idx := i_id_idx + 1;
  }
  return out;
}

method afterReapplying(present: seq<string>, erasures: seq<string>) returns (res: seq<string>)
  ensures forall i: nat :: ((i < |res|) ==> !((res[i] in erasures)))
  ensures forall j: nat :: ((j < |present|) ==> !((present[j] in erasures)) ==> (present[j] in res))
  ensures forall i: nat :: ((i < |res|) ==> (res[i] in present))
{
  var out: seq<string> := [];
  var i_id_idx := 0;
  while i_id_idx < |present|
    invariant (i_id_idx <= |present|)
    invariant forall i: nat :: ((i < |out|) ==> !((out[i] in erasures)))
    invariant forall j: nat :: ((j < i_id_idx) ==> !((present[j] in erasures)) ==> (present[j] in out))
    invariant forall i: nat :: ((i < |out|) ==> (out[i] in present))
  {
    var id := present[i_id_idx];
    if !((id in erasures)) {
      out := (out + [id]);
    }
    i_id_idx := i_id_idx + 1;
  }
  return out;
}
