// Generated by lsc from living.ts

datatype CalendarDay = CalendarDay(year: int, month: int, day: int)

const LIVING_YEARS: int := 100

method isLivingOn(deathRecorded: bool, birthLatest: seq<CalendarDay>, today: CalendarDay) returns (res: bool)
  requires (1 <= today.month)
  requires (today.month <= 12)
  requires (1 <= today.day)
  requires (today.day <= 31)
  requires forall i: nat :: ((i < |birthLatest|) ==> ((((1 <= birthLatest[i].month) && (birthLatest[i].month <= 12)) && (1 <= birthLatest[i].day)) && (birthLatest[i].day <= 31)))
  ensures (res == (!(deathRecorded) && forall i: nat :: ((i < |birthLatest|) ==> ((birthLatest[i].year > (today.year - LIVING_YEARS)) || ((birthLatest[i].year == (today.year - LIVING_YEARS)) && ((birthLatest[i].month > today.month) || ((birthLatest[i].month == today.month) && (birthLatest[i].day >= today.day))))))))
  ensures (deathRecorded ==> !(res))
  ensures (!(deathRecorded) ==> (|birthLatest| == 0) ==> res)
  ensures ((exists i: nat :: ((i < |birthLatest|) && (birthLatest[i].year < (today.year - LIVING_YEARS)))) ==> !(res))
  ensures (!(deathRecorded) ==> (forall i: nat :: ((i < |birthLatest|) ==> (birthLatest[i].year > (today.year - LIVING_YEARS)))) ==> res)
{
  if deathRecorded {
    return false;
  }
  var cutoff := ((((today.year - LIVING_YEARS) * 10000) + (today.month * 100)) + today.day);
  var i_latest_idx := 0;
  while i_latest_idx < |birthLatest|
    invariant (i_latest_idx <= |birthLatest|)
    invariant forall j: nat :: ((j < i_latest_idx) ==> ((((birthLatest[j].year * 10000) + (birthLatest[j].month * 100)) + birthLatest[j].day) >= cutoff))
  {
    var latest := birthLatest[i_latest_idx];
    if ((((latest.year * 10000) + (latest.month * 100)) + latest.day) < cutoff) {
      return false;
    }
    i_latest_idx := i_latest_idx + 1;
  }
  return true;
}
