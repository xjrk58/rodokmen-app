// Generated by lsc from presumed-death.ts

datatype BirthAnchor = BirthAnchor(person: int, kind: int, day: int)

datatype BoundChain = BoundChain(persons: seq<int>, values: seq<int>, rules: seq<int>)

datatype ParentLink = ParentLink(parent: int, child: int, mother: bool)

function anchorBound(a: BirthAnchor): int
{
  if (a.kind == MARRIAGE) then
    (a.day - (MIN_AGE_AT_MARRIAGE * YEAR))
  else
    if (a.kind == PARENT_DEATH) then
      (a.day + (MAX_AFTER_PARENT_DEATH * YEAR))
    else
      a.day
}

lemma anchorBound_ensures(a: BirthAnchor)
  ensures ((a.kind == MARRIAGE) ==> (anchorBound(a) == (a.day - (MIN_AGE_AT_MARRIAGE * YEAR))))
  ensures ((a.kind == PARENT_DEATH) ==> (anchorBound(a) == (a.day + (MAX_AFTER_PARENT_DEATH * YEAR))))
  ensures ((a.kind != MARRIAGE) ==> (a.kind != PARENT_DEATH) ==> (anchorBound(a) == a.day))
{
}

function endsAt(c: BoundChain, p: int): bool
{
  ((((|c.rules| > 0) && (|c.persons| == |c.rules|)) && (|c.values| == |c.rules|)) && (c.persons[(|c.rules| - 1)] == p))
}

function isStep(c: BoundChain, anchors: seq<BirthAnchor>, links: seq<ParentLink>, i: int): bool
  requires (0 <= i)
  requires (i < |c.rules|)
  requires (|c.persons| == |c.rules|)
  requires (|c.values| == |c.rules|)
{
  var r := c.rules[i];
  if (i == 0) then
    ((((0 <= r) && (r < |anchors|)) && (anchors[r].person == c.persons[0])) && (c.values[0] == anchorBound(anchors[r])))
  else
    if ((0 <= r) && (r < |links|)) then
      (((links[r].child == c.persons[(i - 1)]) && (links[r].parent == c.persons[i])) && (c.values[i] == (c.values[(i - 1)] - (MIN_PARENT_AGE * YEAR))))
    else
      (((|links| <= r) && (r < (|links| + |links|))) && (((links[(r - |links|)].mother && (links[(r - |links|)].parent == c.persons[(i - 1)])) && (links[(r - |links|)].child == c.persons[i])) && (c.values[i] == (c.values[(i - 1)] + (MAX_MOTHER_AGE * YEAR)))))
}

const YEAR: int := 10000

const MIN_AGE_AT_MARRIAGE: int := 12

const MIN_PARENT_AGE: int := 12

const MAX_AFTER_PARENT_DEATH: int := 1

const MAX_MOTHER_AGE: int := 60

const MARRIAGE: int := 1

const PARENT_DEATH: int := 2

method checkChain(c: BoundChain, anchors: seq<BirthAnchor>, links: seq<ParentLink>, p: int) returns (res: bool)
  ensures (res ==> (endsAt(c, p) && forall i: nat :: ((i < |c.rules|) ==> isStep(c, anchors, links, i))))
{
  var i_t0 := endsAt(c, p);
  if !(i_t0) {
    return false;
  }
  var i := 0;
  while (i < |c.rules|)
    invariant (0 <= i)
    invariant (i <= |c.rules|)
    invariant forall j: nat :: ((j < i) ==> isStep(c, anchors, links, j))
    decreases (|c.rules| - i)
  {
    var i_t1 := isStep(c, anchors, links, i);
    if !(i_t1) {
      return false;
    }
    i := (i + 1);
  }
  return true;
}

method presumedDead(count: int, hasDeath: seq<bool>, ownBirth: seq<bool>, anchors: seq<BirthAnchor>, links: seq<ParentLink>, chains: seq<BoundChain>, cutoff: int) returns (res: seq<bool>)
  requires (|hasDeath| == count)
  requires (|ownBirth| == count)
  requires (|chains| == count)
  ensures (|res| == count)
  ensures forall p: nat :: ((p < count) ==> res[p] ==> (!(hasDeath[p]) && !(ownBirth[p])))
  ensures forall p: nat :: ((p < count) ==> res[p] ==> ((endsAt(chains[p], p) && (chains[p].values[(|chains[p].rules| - 1)] < cutoff)) && forall i: nat :: ((i < |chains[p].rules|) ==> isStep(chains[p], anchors, links, i))))
  ensures forall p: nat :: ((p < count) ==> (forall a: nat :: ((a < |anchors|) ==> (anchors[a].person != p))) ==> (forall j: nat :: ((j < |links|) ==> ((links[j].parent != p) && (links[j].child != p)))) ==> !(res[p]))
{
  var dead: seq<bool> := [];
  var p := 0;
  while (p < count)
    invariant (0 <= p)
    invariant (p <= count)
    invariant (|dead| == p)
    invariant forall u: nat :: ((u < p) ==> dead[u] ==> (!(hasDeath[u]) && !(ownBirth[u])))
    invariant forall u: nat :: ((u < p) ==> dead[u] ==> ((endsAt(chains[u], u) && (chains[u].values[(|chains[u].rules| - 1)] < cutoff)) && forall i: nat :: ((i < |chains[u].rules|) ==> isStep(chains[u], anchors, links, i))))
    invariant forall u: nat :: ((u < p) ==> (forall a: nat :: ((a < |anchors|) ==> (anchors[a].person != u))) ==> (forall j: nat :: ((j < |links|) ==> ((links[j].parent != u) && (links[j].child != u)))) ==> !(dead[u]))
    decreases (count - p)
  {
    var c := chains[p];
    var i_t2 := checkChain(c, anchors, links, p);
    var chained := i_t2;
    // Proof addition: a chain that ends at this Person needs a fact or a parent link of theirs.
    if chained { ChainNeedsFactOrLink(c, anchors, links, p); }
    dead := (dead + [(((!(hasDeath[p]) && !(ownBirth[p])) && chained) && (c.values[(|c.rules| - 1)] < cutoff))]);
    p := (p + 1);
  }
  return dead;
}

// Proof addition: the last step of a chain names its Person, by a fact of theirs or by a parent link.
lemma ChainNeedsFactOrLink(c: BoundChain, anchors: seq<BirthAnchor>, links: seq<ParentLink>, p: int)
  requires endsAt(c, p)
  requires forall i: nat :: i < |c.rules| ==> isStep(c, anchors, links, i)
  ensures (exists a: nat :: a < |anchors| && anchors[a].person == p) || (exists j: nat :: j < |links| && (links[j].parent == p || links[j].child == p))
{
  var n: nat := |c.rules| - 1;
  assert isStep(c, anchors, links, n);
  var r := c.rules[n];
  if n == 0 {
    assert anchors[r].person == p;
  } else if 0 <= r < |links| {
    assert links[r].parent == p;
  } else {
    var j: nat := r - |links|;
    assert links[j].child == p;
  }
}

// Proof addition: birth days that keep the bounds. Each Person's birth is on or before the day each
// fact of theirs allows, each parent is born at least MIN_PARENT_AGE years before their child, and
// each child at most MAX_MOTHER_AGE years after their mother.
ghost predicate KeepsBounds(t: seq<int>, anchors: seq<BirthAnchor>, links: seq<ParentLink>)
{
  (forall a: nat :: a < |anchors| && 0 <= anchors[a].person < |t| ==> t[anchors[a].person] <= anchorBound(anchors[a])) &&
  (forall j: nat :: j < |links| && 0 <= links[j].parent < |t| && 0 <= links[j].child < |t| ==> t[links[j].parent] <= t[links[j].child] - MIN_PARENT_AGE * YEAR) &&
  (forall j: nat :: j < |links| && links[j].mother && 0 <= links[j].parent < |t| && 0 <= links[j].child < |t| ==> t[links[j].child] <= t[links[j].parent] + MAX_MOTHER_AGE * YEAR)
}

// Proof addition: soundness. For any birth days that keep the bounds, every Person on a chain whose
// steps follow was born on or before the chain's value for them; so a Person presumed dead was born
// before the cutoff, whatever their real birth day.
lemma ChainBoundsBirth(t: seq<int>, anchors: seq<BirthAnchor>, links: seq<ParentLink>, c: BoundChain, k: nat)
  requires KeepsBounds(t, anchors, links)
  requires |c.persons| == |c.rules| && |c.values| == |c.rules| && k < |c.rules|
  requires forall i: nat :: i < |c.rules| ==> 0 <= c.persons[i] < |t|
  requires forall i: nat :: i < |c.rules| ==> isStep(c, anchors, links, i)
  ensures t[c.persons[k]] <= c.values[k]
{
  assert isStep(c, anchors, links, k);
  if k > 0 {
    ChainBoundsBirth(t, anchors, links, c, k - 1);
  }
}
