  ensures (res.unlogged == leavesUnlogged(undoneProposalId, deletions, dependencies, touches))
  ensures ((|deletions| == 0) ==> ((|res.blockedBy| == 0) && !(res.unlogged)))
{
  var i_t6 := leftBehind(deletions, dependencies);
  var remaining := i_t6;
  var i_t7 := loggedBlockers(undoneProposalId, deletions, dependencies, remaining, touches);
  var logged := i_t7;
  var i_t8 := newestFirst(logged.found);
  var sorted := i_t8;
  var ids := seq(|sorted|, i_map requires 0 <= i_map < |sorted| => var t := sorted[i_map]; t.proposalId);
  return UndoBlockers(ids, logged.unlogged);
}
