function isCitationOperation(op: string): bool
{
  ((op == "createCitation") || (op == "attachCitation"))
}

function isFactFreeOperation(op: string): bool
{
  (((op == "mergePersons") || (op == "restoreRecord")) || (op == "setFamilyRoot"))
}

function sameRecord(a: RecordKey, b: RecordKey): bool
{
  ((a.table == b.table) && (a.id == b.id))
}

function isDeletion(deletions: seq<RecordKey>, r: RecordKey): bool
{
  (exists x :: x in deletions && sameRecord(x, r))
}

function leavesDependent(deletions: seq<RecordKey>, d: Dependency): bool
{
  (isDeletion(deletions, d.of) && !(isDeletion(deletions, d.dependent)))
}

