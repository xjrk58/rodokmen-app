// Generated by lsc from leads.ts

datatype LeadState = LeadState(id: string, status: string, foundBy: string)

datatype PersonLink = PersonLink(personId: string, living: bool)

datatype ExportedLinks = ExportedLinks(include_: bool, persons: seq<PersonLink>)

function isLeadStatus(status: string): bool
{
  ((((status == "open") || (status == "in_progress")) || (status == "found")) || (status == "not_found"))
}

function mayHaveStatus(status: string, searches: int): bool
{
  if (status == "not_found") then
    (searches > 0)
  else
    isLeadStatus(status)
}

lemma mayHaveStatus_ensures(status: string, searches: int)
  ensures ((status == "not_found") ==> (mayHaveStatus(status, searches) == (searches > 0)))
  ensures ((status == "not_found") ==> (searches <= 0) ==> !(mayHaveStatus(status, searches)))
  ensures ((((status == "open") || (status == "in_progress")) || (status == "found")) ==> mayHaveStatus(status, searches))
  ensures (mayHaveStatus(status, searches) ==> isLeadStatus(status))
{
}

function isFoundBy(lead: LeadState, proposalId: string): bool
{
  (((proposalId != "") && (lead.status == "found")) && (lead.foundBy == proposalId))
}

method leadsOnAccept(leads: seq<LeadState>, answers: seq<string>, proposalId: string) returns (res: seq<LeadState>)
  ensures (|res| == |leads|)
  ensures forall i: nat :: ((i < |leads|) ==> (leads[i].id in answers) ==> (((res[i].id == leads[i].id) && (res[i].status == "found")) && (res[i].foundBy == proposalId)))
  ensures forall i: nat :: ((i < |leads|) ==> !((leads[i].id in answers)) ==> (res[i] == leads[i]))
{
  var out: seq<LeadState> := [];
  var i_lead_idx := 0;
  while i_lead_idx < |leads|
    invariant (i_lead_idx <= |leads|)
    invariant (|out| == i_lead_idx)
    invariant forall j: nat :: ((j < i_lead_idx) ==> (leads[j].id in answers) ==> (((out[j].id == leads[j].id) && (out[j].status == "found")) && (out[j].foundBy == proposalId)))
    invariant forall j: nat :: ((j < i_lead_idx) ==> !((leads[j].id in answers)) ==> (out[j] == leads[j]))
  {
    var lead := leads[i_lead_idx];
    if (lead.id in answers) {
      out := (out + [LeadState(lead.id, "found", proposalId)]);
    } else {
      out := (out + [lead]);
    }
    i_lead_idx := i_lead_idx + 1;
  }
  return out;
}

method leadsOnUndo(leads: seq<LeadState>, proposalId: string) returns (res: seq<LeadState>)
  ensures (|res| == |leads|)
  ensures forall i: nat :: ((i < |leads|) ==> isFoundBy(leads[i], proposalId) ==> (((res[i].id == leads[i].id) && (res[i].status == "open")) && (res[i].foundBy == "")))
  ensures forall i: nat :: ((i < |leads|) ==> !(isFoundBy(leads[i], proposalId)) ==> (res[i] == leads[i]))
  ensures forall i: nat :: ((i < |leads|) ==> (leads[i].foundBy != proposalId) ==> (res[i] == leads[i]))
{
  var out: seq<LeadState> := [];
  var i_lead_idx := 0;
  while i_lead_idx < |leads|
    invariant (i_lead_idx <= |leads|)
    invariant (|out| == i_lead_idx)
    invariant forall j: nat :: ((j < i_lead_idx) ==> isFoundBy(leads[j], proposalId) ==> (((out[j].id == leads[j].id) && (out[j].status == "open")) && (out[j].foundBy == "")))
    invariant forall j: nat :: ((j < i_lead_idx) ==> !(isFoundBy(leads[j], proposalId)) ==> (out[j] == leads[j]))
  {
    var lead := leads[i_lead_idx];
    var i_t0 := isFoundBy(lead, proposalId);
    if i_t0 {
      out := (out + [LeadState(lead.id, "open", "")]);
    } else {
      out := (out + [lead]);
    }
    i_lead_idx := i_lead_idx + 1;
  }
  return out;
}

method exportedPersonLinks(links: seq<PersonLink>) returns (res: ExportedLinks)
  ensures forall i: nat :: ((i < |res.persons|) ==> !(res.persons[i].living))
  ensures forall j: nat :: ((j < |links|) ==> !(links[j].living) ==> (links[j] in res.persons))
  ensures forall i: nat :: ((i < |res.persons|) ==> (res.persons[i] in links))
  ensures ((|links| > 0) ==> (forall j: nat :: ((j < |links|) ==> links[j].living)) ==> !(res.include_))
  ensures (res.include_ == ((|links| == 0) || (|res.persons| > 0)))
{
  var persons: seq<PersonLink> := [];
  var i_link_idx := 0;
  while i_link_idx < |links|
    invariant (i_link_idx <= |links|)
    invariant forall i: nat :: ((i < |persons|) ==> !(persons[i].living))
    invariant forall j: nat :: ((j < i_link_idx) ==> !(links[j].living) ==> (links[j] in persons))
    invariant forall i: nat :: ((i < |persons|) ==> (persons[i] in links))
    invariant ((|persons| > 0) ==> exists j: nat :: ((j < i_link_idx) && !(links[j].living)))
  {
    var link := links[i_link_idx];
    if !(link.living) {
      persons := (persons + [link]);
    }
    i_link_idx := i_link_idx + 1;
  }
  return ExportedLinks(((|links| == 0) || (|persons| > 0)), persons);
}
