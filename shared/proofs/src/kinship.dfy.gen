function isStepUp(dist: seq<int>, via: seq<int>, links: seq<ParentLink>, v: int): bool
  requires (0 <= v)
  requires (v < |dist|)
  requires (|dist| == |via|)
  requires forall i: nat :: ((i < |links|) ==> ((((0 <= links[i].child) && (links[i].child < |dist|)) && (0 <= links[i].parent)) && (links[i].parent < |dist|)))
{
  var i := via[v];
  if ((i < 0) || (i >= |links|)) then
    false
  else
    var l := links[i];
    ((isFollowed(l) && (l.parent == v)) && (dist[l.child] == (dist[v] - 1)))
}

function linkedAt(links: seq<ParentLink>, used: seq<int>, persons: seq<int>, k: int): bool
  requires (0 <= k)
  requires (k < |used|)
  requires (|used| < |persons|)
{
  var i := used[k];
  if ((i < 0) || (i >= |links|)) then
    false
  else
    ((isFollowed(links[i]) && (links[i].parent == persons[k])) && (links[i].child == persons[(k + 1)]))
}

function kindRank(kind: int): int
{
  if (kind == SELF) then
    0
  else
    if (kind == PARTNER) then
      1
    else
      if hasDegree(kind) then
        2
      else
        if (kind == STEP_SIBLING) then
          3
        else
          if (kind == CO_PARENT_IN_LAW) then
            4
          else
            if (kind == FOSTER) then
              5
            else
              6
}

