}

function compareFrom(a: seq<int>, b: seq<int>, i: int): int
  requires (|a| == |b|)
  requires (0 <= i)
  requires (i <= |a|)
  decreases (|a| - i)
{
  if (i >= |a|) then
    0
  else
    if (a[i] != b[i]) then
      compareInts(a[i], b[i])
    else
      compareFrom(a, b, (i + 1))
}

lemma compareFrom_ensures(a: seq<int>, b: seq<int>, i: int)
  requires (|a| == |b|)
