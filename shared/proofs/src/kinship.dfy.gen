  ensures (0 <= kindRank(kind))
  ensures (kindRank(kind) <= 6)
  ensures ((kindRank(kind) == 2) <==> hasDegree(kind))
{
}

function compareInts(a: int, b: int): int
{
  if (a < b) then
    -1
  else
    if (a > b) then
      1
    else
      0
}

lemma compareInts_ensures(a: int, b: int)
  ensures ((compareInts(a, b) == -1) <==> (a < b))
  ensures ((compareInts(a, b) == 0) <==> (a == b))
  ensures ((compareInts(a, b) == 1) <==> (a > b))
