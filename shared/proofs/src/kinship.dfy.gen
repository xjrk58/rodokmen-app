function marriageRank(kind: int): int
{
  if (kind == MARRIAGE) then
    1
  else
    0
}

function compareKinshipPaths(a: PathKey, b: PathKey): int
{
  var rank := compareInts(kindRank(a.kind), kindRank(b.kind));
  if (rank != 0) then
    rank
  else
    if hasDegree(a.kind) then
      var degree := compareInts(a.degree, b.degree);
      if (degree != 0) then
        degree
      else
        var marriage := compareInts(marriageRank(a.kind), marriageRank(b.kind));
        if (marriage != 0) then
          marriage
        else
          if (a.possible != b.possible) then
            if a.possible then
              1
            else
              -1
          else
            var up := compareInts(a.up, b.up);
            if (up != 0) then
              up
            else
              var down := compareInts(a.down, b.down);
              if (down != 0) then
                down
              else
                comparePersons(a.persons, b.persons)
    else
      if (a.possible != b.possible) then
        if a.possible then
          1
        else
          -1
      else
        var up := compareInts(a.up, b.up);
        if (up != 0) then
          up
        else
          var down := compareInts(a.down, b.down);
          if (down != 0) then
            down
          else
            comparePersons(a.persons, b.persons)
}

lemma compareKinshipPaths_ensures(a: PathKey, b: PathKey)
  ensures (((compareKinshipPaths(a, b) == -1) || (compareKinshipPaths(a, b) == 0)) || (compareKinshipPaths(a, b) == 1))
  ensures (compareKinshipPaths(b, a) == (-(compareKinshipPaths(a, b))))
  ensures ((compareKinshipPaths(a, b) == 0) ==> (((((kindRank(a.kind) == kindRank(b.kind)) && (a.possible == b.possible)) && (a.up == b.up)) && (a.down == b.down)) && (a.persons == b.persons)))
  ensures ((kindRank(a.kind) < kindRank(b.kind)) ==> (compareKinshipPaths(a, b) == -1))
  ensures (hasDegree(a.kind) ==> hasDegree(b.kind) ==> (a.degree < b.degree) ==> (compareKinshipPaths(a, b) == -1))
  ensures (hasDegree(a.kind) ==> hasDegree(b.kind) ==> (a.degree == b.degree) ==> (a.kind == BIRTH) ==> (b.kind == MARRIAGE) ==> (compareKinshipPaths(a, b) == -1))
  ensures ((kindRank(a.kind) == kindRank(b.kind)) ==> (!(hasDegree(a.kind)) || ((a.degree == b.degree) && (marriageRank(a.kind) == marriageRank(b.kind)))) ==> !(a.possible) ==> b.possible ==> (compareKinshipPaths(a, b) == -1))
{
}

function isPossiblePath(links: seq<FamilyLink>): bool
{
  (exists l :: l in links && !(isStrongLink(l)))
}

