function besideOwnCouple(steps: seq<PathStep>, k: int): bool
  requires (0 <= k)
  requires (k < |steps|)
{
  if (steps[k].dir != ACROSS) then
    false
  else
    var c := steps[k].couple;
    (((((k + 1) < |steps|) && (steps[(k + 1)].dir != ACROSS)) && (steps[(k + 1)].couple == c)) || (((k > 0) && (steps[(k - 1)].dir != ACROSS)) && (steps[(k - 1)].couple == c)))
}

lemma besideOwnCouple_ensures(steps: seq<PathStep>, k: int)
  requires (0 <= k)
  requires (k < |steps|)
  ensures ((steps[k].dir != ACROSS) ==> !(besideOwnCouple(steps, k)))
  ensures ((k == 0) ==> (|steps| >= 2) ==> (steps[0].dir == ACROSS) ==> (steps[1].dir == DOWN) ==> (steps[0].couple == steps[1].couple) ==> besideOwnCouple(steps, k))
  ensures ((|steps| == 2) ==> (steps[0].dir == UP) ==> (steps[1].dir == ACROSS) ==> (steps[0].couple != steps[1].couple) ==> !(besideOwnCouple(steps, k)))
{
}

function joins(links: seq<FamilyLink>, i: int, u: int, w: int): bool
  requires (0 <= i)
  requires (i < |links|)
{
  (((links[i].a == u) && (links[i].b == w)) || ((links[i].a == w) && (links[i].b == u)))
}

function joinsAt(links: seq<FamilyLink>, used: seq<int>, persons: seq<int>, k: int): bool
  requires (0 <= k)
  requires (k < |used|)
  requires (|used| < |persons|)
{
  var i := used[k];
  if ((i < 0) || (i >= |links|)) then
    false
  else
    joins(links, i, persons[k], persons[(k + 1)])
}

function isStepNearer(dist: seq<int>, via: seq<int>, links: seq<FamilyLink>, v: int): bool
  requires (0 <= v)
  requires (v < |dist|)
  requires (|dist| == |via|)
  requires forall i: nat :: ((i < |links|) ==> ((((0 <= links[i].a) && (links[i].a < |dist|)) && (0 <= links[i].b)) && (links[i].b < |dist|)))
{
  var i := via[v];
  if ((i < 0) || (i >= |links|)) then
    false
  else
    var l := links[i];
    if (l.a == v) then
      (dist[l.b] == (dist[v] - 1))
    else
      ((l.b == v) && (dist[l.a] == (dist[v] - 1)))
}

const SELF: int := 0

const PARTNER: int := 1

const BIRTH: int := 2

const MARRIAGE: int := 3

const STEP_SIBLING: int := 4

const CO_PARENT_IN_LAW: int := 5

const FOSTER: int := 6

const NO_LINE: int := 0

const DIRECT: int := 1

const COLLATERAL: int := 2

const NO_DEGREE: int := -1

const BIRTH_LINK: int := 0

const ADOPTIVE_LINK: int := 1

const UP: int := 0

const DOWN: int := 1

const ACROSS: int := 2

const MAX_GENERATIONS: int := 12

method chainsUp(count: int, start: int, links: seq<ParentLink>) returns (res: Chains)
  requires (0 <= start)
  requires (start < count)
  requires forall i: nat :: ((i < |links|) ==> ((((0 <= links[i].child) && (links[i].child < count)) && (0 <= links[i].parent)) && (links[i].parent < count)))
  ensures (|res.dist| == count)
  ensures (|res.via| == count)
  ensures (res.dist[start] == 0)
  ensures forall v: nat :: ((v < count) ==> (res.dist[v] == 0) ==> (v == start))
  ensures forall v: nat :: ((v < count) ==> ((-1 <= res.dist[v]) && (res.dist[v] <= MAX_GENERATIONS)))
  ensures forall i: nat :: ((i < |links|) ==> isFollowed(links[i]) ==> (0 <= res.dist[links[i].child]) ==> (res.dist[links[i].child] < MAX_GENERATIONS) ==> ((0 <= res.dist[links[i].parent]) && (res.dist[links[i].parent] <= (res.dist[links[i].child] + 1))))
  ensures forall v: nat :: ((v < count) ==> (res.dist[v] > 0) ==> isStepUp(res.dist, res.via, links, v))
{
  var dist: seq<int> := [];
  var via: seq<int> := [];
  var v := 0;
  while (v < count)
    invariant (0 <= v)
    invariant (v <= count)
    invariant (|dist| == v)
    invariant (|via| == v)
    invariant forall u: nat :: ((u < v) ==> (((via[u] == -1) && ((u == start) ==> (dist[u] == 0))) && ((u != start) ==> (dist[u] == -1))))
    decreases (count - v)
  {
    dist := (dist + [(if (v == start) then 0 else -1)]);
    via := (via + [-1]);
    v := (v + 1);
  }
  var d := 0;
  var grew := true;
  while ((d < MAX_GENERATIONS) && grew)
    invariant (0 <= d)
    invariant (d <= MAX_GENERATIONS)
    invariant (|dist| == count)
    invariant (|via| == count)
    invariant (dist[start] == 0)
    invariant forall u: nat :: ((u < count) ==> ((-1 <= dist[u]) && (dist[u] <= d)))
    invariant forall u: nat :: ((u < count) ==> (dist[u] == 0) ==> (u == start))
    invariant forall u: nat :: ((u < count) ==> (dist[u] > 0) ==> isStepUp(dist, via, links, u))
    invariant forall j: nat :: ((j < |links|) ==> isFollowed(links[j]) ==> (0 <= dist[links[j].child]) ==> (dist[links[j].child] < d) ==> ((0 <= dist[links[j].parent]) && (dist[links[j].parent] <= (dist[links[j].child] + 1))))
    invariant (!(grew) ==> forall u: nat :: ((u < count) ==> (dist[u] < d)))
    decreases (MAX_GENERATIONS - d)
  {
    grew := false;
    var i := 0;
    while (i < |links|)
      invariant (0 <= i)
      invariant (i <= |links|)
      invariant (|dist| == count)
      invariant (|via| == count)
      invariant (dist[start] == 0)
      invariant forall u: nat :: ((u < count) ==> ((-1 <= dist[u]) && (dist[u] <= (d + 1))))
      invariant forall u: nat :: ((u < count) ==> (dist[u] == 0) ==> (u == start))
      invariant forall u: nat :: ((u < count) ==> (dist[u] > 0) ==> isStepUp(dist, via, links, u))
      invariant forall j: nat :: ((j < |links|) ==> isFollowed(links[j]) ==> (0 <= dist[links[j].child]) ==> (dist[links[j].child] < d) ==> ((0 <= dist[links[j].parent]) && (dist[links[j].parent] <= (dist[links[j].child] + 1))))
      invariant forall j: nat :: ((j < i) ==> isFollowed(links[j]) ==> (dist[links[j].child] == d) ==> ((0 <= dist[links[j].parent]) && (dist[links[j].parent] <= (d + 1))))
      invariant (!(grew) ==> forall u: nat :: ((u < count) ==> (dist[u] <= d)))
      decreases (|links| - i)
    {
      var l := links[i];
      var i_t0 := isFollowed(l);
      if ((i_t0 && (dist[l.child] == d)) && (dist[l.parent] == -1)) {
        dist := dist[l.parent := (d + 1)];
        via := via[l.parent := i];
        grew := true;
      }
      i := (i + 1);
    }
    d := (d + 1);
  }
  return Chains(dist, via);
}

method chainDown(c: Chains, count: int, start: int, links: seq<ParentLink>, top: int) returns (res: Chain)
  requires (|c.dist| == count)
  requires (|c.via| == count)
  requires (0 <= start)
  requires (start < count)
  requires (0 <= top)
  requires (top < count)
  requires forall i: nat :: ((i < |links|) ==> ((((0 <= links[i].child) && (links[i].child < count)) && (0 <= links[i].parent)) && (links[i].parent < count)))
  requires (c.dist[top] >= 0)
  requires forall v: nat :: ((v < count) ==> (c.dist[v] == 0) ==> (v == start))
  requires forall v: nat :: ((v < count) ==> (c.dist[v] > 0) ==> isStepUp(c.dist, c.via, links, v))
  ensures (|res.persons| == (c.dist[top] + 1))
  ensures (|res.links| == c.dist[top])
  ensures (res.persons[0] == top)
  ensures (res.persons[c.dist[top]] == start)
  ensures forall k: nat :: ((k < |res.persons|) ==> (((0 <= res.persons[k]) && (res.persons[k] < count)) && (c.dist[res.persons[k]] == (c.dist[top] - k))))
  ensures forall k: nat :: ((k < |res.links|) ==> linkedAt(links, res.links, res.persons, k))
{
  var persons := [top];
  var used: seq<int> := [];
  var v := top;
  while (c.dist[v] > 0)
    invariant (0 <= v)
    invariant (v < count)
    invariant (c.dist[v] >= 0)
    invariant (|persons| == ((c.dist[top] - c.dist[v]) + 1))
    invariant (|used| == (|persons| - 1))
    invariant (persons[0] == top)
    invariant (persons[(|persons| - 1)] == v)
    invariant forall k: nat :: ((k < |persons|) ==> (((0 <= persons[k]) && (persons[k] < count)) && (c.dist[persons[k]] == (c.dist[top] - k))))
    invariant forall k: nat :: ((k < |used|) ==> linkedAt(links, used, persons, k))
    decreases c.dist[v]
  {
    assert isStepUp(c.dist, c.via, links, v);
    var i := c.via[v];
    var l := links[i];
    used := (used + [i]);
    persons := (persons + [l.child]);
    v := l.child;
  }
  return Chain(persons, used);
}

method closestPath(count: int, from: int, to: int, links: seq<ParentLink>) returns (res: Closest)
  requires (0 <= from)
  requires (from < count)
  requires (0 <= to)
  requires (to < count)
  requires forall i: nat :: ((i < |links|) ==> ((((0 <= links[i].child) && (links[i].child < count)) && (0 <= links[i].parent)) && (links[i].parent < count)))
  ensures (|res.fromUp.dist| == count)
  ensures (|res.toUp.dist| == count)
  ensures (res.fromUp.dist[from] == 0)
  ensures (res.toUp.dist[to] == 0)
  ensures forall i: nat :: ((i < |links|) ==> isFollowed(links[i]) ==> (0 <= res.fromUp.dist[links[i].child]) ==> (res.fromUp.dist[links[i].child] < MAX_GENERATIONS) ==> ((0 <= res.fromUp.dist[links[i].parent]) && (res.fromUp.dist[links[i].parent] <= (res.fromUp.dist[links[i].child] + 1))))
  ensures forall i: nat :: ((i < |links|) ==> isFollowed(links[i]) ==> (0 <= res.toUp.dist[links[i].child]) ==> (res.toUp.dist[links[i].child] < MAX_GENERATIONS) ==> ((0 <= res.toUp.dist[links[i].parent]) && (res.toUp.dist[links[i].parent] <= (res.toUp.dist[links[i].child] + 1))))
  ensures (res.found <==> exists v: nat :: (((v < count) && (res.fromUp.dist[v] >= 0)) && (res.toUp.dist[v] >= 0)))
  ensures (res.found ==> ((((0 <= res.top) && (res.top < count)) && (res.fromUp.dist[res.top] >= 0)) && (res.toUp.dist[res.top] >= 0)))
  ensures (res.found ==> forall v: nat :: ((v < count) ==> (res.fromUp.dist[v] >= 0) ==> (res.toUp.dist[v] >= 0) ==> ((|res.toFrom.links| + |res.toTo.links|) <= (res.fromUp.dist[v] + res.toUp.dist[v]))))
  ensures (res.found ==> (((|res.toFrom.persons| == (|res.toFrom.links| + 1)) && (res.toFrom.persons[0] == res.top)) && (res.toFrom.persons[|res.toFrom.links|] == from)))
  ensures (res.found ==> (((|res.toTo.persons| == (|res.toTo.links| + 1)) && (res.toTo.persons[0] == res.top)) && (res.toTo.persons[|res.toTo.links|] == to)))
  ensures (res.found ==> forall k: nat :: ((k < |res.toFrom.links|) ==> linkedAt(links, res.toFrom.links, res.toFrom.persons, k)))
  ensures (res.found ==> forall k: nat :: ((k < |res.toTo.links|) ==> linkedAt(links, res.toTo.links, res.toTo.persons, k)))
  ensures (res.found ==> forall i: nat, j: nat :: ((i < |res.toFrom.persons|) ==> (j < |res.toTo.persons|) ==> (res.toFrom.persons[i] == res.toTo.persons[j]) ==> ((i == 0) && (j == 0))))
{
  var i_t1 := chainsUp(count, from, links);
  var fromUp := i_t1;
  var i_t2 := chainsUp(count, to, links);
  var toUp := i_t2;
  var i_t3 := nearestCommon(count, fromUp.dist, toUp.dist);
  var top := i_t3;
  if (top == -1) {
    return Closest(false, -1, Chain([], []), Chain([], []), fromUp, toUp);
  }
  var i_t4 := chainDown(fromUp, count, from, links, top);
  var toFrom := i_t4;
  var i_t5 := chainDown(toUp, count, to, links, top);
  var toTo := i_t5;
  return Closest(true, top, toFrom, toTo, fromUp, toUp);
}

method nearestCommon(count: int, a: seq<int>, b: seq<int>) returns (res: int)
  requires (|a| == count)
  requires (|b| == count)
  ensures (-1 <= res)
  ensures (res < count)
  ensures ((res == -1) <==> forall v: nat :: ((v < count) ==> !(((a[v] >= 0) && (b[v] >= 0)))))
  ensures ((res >= 0) ==> ((a[res] >= 0) && (b[res] >= 0)))
  ensures ((res >= 0) ==> forall v: nat :: ((v < count) ==> (a[v] >= 0) ==> (b[v] >= 0) ==> ((a[res] + b[res]) <= (a[v] + b[v]))))
{
  var top := -1;
  var best := 0;
  var v := 0;
  while (v < count)
    invariant (0 <= v)
    invariant (v <= count)
    invariant (-1 <= top)
    invariant (top < v)
    invariant ((top == -1) ==> forall u: nat :: ((u < v) ==> !(((a[u] >= 0) && (b[u] >= 0)))))
    invariant ((top >= 0) ==> (((a[top] >= 0) && (b[top] >= 0)) && (best == (a[top] + b[top]))))
    invariant ((top >= 0) ==> forall u: nat :: ((u < v) ==> (a[u] >= 0) ==> (b[u] >= 0) ==> (best <= (a[u] + b[u]))))
    decreases (count - v)
  {
    var x := a[v];
    var y := b[v];
    if (((x >= 0) && (y >= 0)) && ((top == -1) || ((x + y) < best))) {
      top := v;
      best := (x + y);
    }
    v := (v + 1);
  }
  return top;
}

method namesOwnParentOrChild(steps: seq<PathStep>) returns (res: bool)
  ensures (res <==> !(forall k: nat :: ((k < |steps|) ==> !(besideOwnCouple(steps, k)))))
{
  var i := 0;
  while (i < |steps|)
    invariant (0 <= i)
    invariant (i <= |steps|)
    invariant forall k: nat :: ((k < i) ==> !(besideOwnCouple(steps, k)))
    decreases (|steps| - i)
  {
    var i_t6 := besideOwnCouple(steps, i);
    if i_t6 {
      return true;
    }
    i := (i + 1);
  }
  return false;
}

method connectionChain(count: int, from: int, to: int, links: seq<FamilyLink>) returns (res: Connection)
  requires (0 <= from)
  requires (from < count)
  requires (0 <= to)
  requires (to < count)
  requires forall i: nat :: ((i < |links|) ==> ((((0 <= links[i].a) && (links[i].a < count)) && (0 <= links[i].b)) && (links[i].b < count)))
  ensures (|res.reached| == count)
  ensures res.reached[to]
  ensures (res.found <==> res.reached[from])
  ensures (res.found ==> (((|res.persons| == (|res.links| + 1)) && (res.persons[0] == from)) && (res.persons[|res.links|] == to)))
  ensures (res.found ==> forall k: nat :: ((k < |res.persons|) ==> ((0 <= res.persons[k]) && (res.persons[k] < count))))
  ensures (res.found ==> forall k: nat :: ((k < |res.links|) ==> joinsAt(links, res.links, res.persons, k)))
  ensures (!(res.found) ==> ((|res.persons| == 0) && (|res.links| == 0)))
  ensures forall i: nat :: ((i < |links|) ==> (res.reached[links[i].a] <==> res.reached[links[i].b]))
{
  var dist: seq<int> := [];
  var via: seq<int> := [];
  var v := 0;
  while (v < count)
    invariant (0 <= v)
    invariant (v <= count)
    invariant (|dist| == v)
    invariant (|via| == v)
    invariant forall u: nat :: ((u < v) ==> (((via[u] == -1) && ((u == to) ==> (dist[u] == 0))) && ((u != to) ==> (dist[u] == -1))))
    decreases (count - v)
  {
    dist := (dist + [(if (v == to) then 0 else -1)]);
    via := (via + [-1]);
    v := (v + 1);
  }
  var d := 0;
  var grew := true;
  while grew
    invariant (d >= 0)
    invariant (|dist| == count)
    invariant (|via| == count)
    invariant (dist[to] == 0)
    invariant forall u: nat :: ((u < count) ==> ((-1 <= dist[u]) && (dist[u] <= d)))
    invariant forall u: nat :: ((u < count) ==> (dist[u] == 0) ==> (u == to))
    invariant forall u: nat :: ((u < count) ==> (dist[u] > 0) ==> isStepNearer(dist, via, links, u))
    invariant forall j: nat :: ((j < |links|) ==> (0 <= dist[links[j].a]) ==> (dist[links[j].a] < d) ==> (dist[links[j].b] >= 0))
    invariant forall j: nat :: ((j < |links|) ==> (0 <= dist[links[j].b]) ==> (dist[links[j].b] < d) ==> (dist[links[j].a] >= 0))
    invariant (!(grew) ==> forall u: nat :: ((u < count) ==> (dist[u] < d)))
  {
    grew := false;
    var i := 0;
    while (i < |links|)
      invariant (0 <= i)
      invariant (i <= |links|)
      invariant (|dist| == count)
      invariant (|via| == count)
      invariant (dist[to] == 0)
      invariant forall u: nat :: ((u < count) ==> ((-1 <= dist[u]) && (dist[u] <= (d + 1))))
      invariant forall u: nat :: ((u < count) ==> (dist[u] == 0) ==> (u == to))
      invariant forall u: nat :: ((u < count) ==> (dist[u] > 0) ==> isStepNearer(dist, via, links, u))
      invariant forall j: nat :: ((j < |links|) ==> (0 <= dist[links[j].a]) ==> (dist[links[j].a] < d) ==> (dist[links[j].b] >= 0))
      invariant forall j: nat :: ((j < |links|) ==> (0 <= dist[links[j].b]) ==> (dist[links[j].b] < d) ==> (dist[links[j].a] >= 0))
      invariant forall j: nat :: ((j < i) ==> (dist[links[j].a] == d) ==> (dist[links[j].b] >= 0))
      invariant forall j: nat :: ((j < i) ==> (dist[links[j].b] == d) ==> (dist[links[j].a] >= 0))
      invariant (!(grew) ==> forall u: nat :: ((u < count) ==> (dist[u] <= d)))
      decreases (|links| - i)
    {
      var l := links[i];
      if ((dist[l.a] == d) && (dist[l.b] == -1)) {
        dist := dist[l.b := (d + 1)];
        via := via[l.b := i];
        grew := true;
      } else if ((dist[l.b] == d) && (dist[l.a] == -1)) {
        dist := dist[l.a := (d + 1)];
        via := via[l.a := i];
        grew := true;
      }
      i := (i + 1);
    }
    d := (d + 1);
  }
  var reached: seq<bool> := [];
  var u := 0;
  while (u < count)
    invariant (0 <= u)
    invariant (u <= count)
    invariant (|reached| == u)
    invariant forall x: nat :: ((x < u) ==> (reached[x] <==> (dist[x] >= 0)))
    decreases (count - u)
  {
    reached := (reached + [(dist[u] >= 0)]);
    u := (u + 1);
  }
  if (dist[from] < 0) {
    return Connection(false, [], [], reached);
  }
  var persons := [from];
  var used: seq<int> := [];
  var w := from;
  while (dist[w] > 0)
    invariant (0 <= w)
    invariant (w < count)
    invariant (dist[w] >= 0)
    invariant (|persons| == ((dist[from] - dist[w]) + 1))
    invariant (|used| == (|persons| - 1))
    invariant (persons[0] == from)
    invariant (persons[(|persons| - 1)] == w)
    invariant forall k: nat :: ((k < |persons|) ==> ((0 <= persons[k]) && (persons[k] < count)))
    invariant forall k: nat :: ((k < |used|) ==> joinsAt(links, used, persons, k))
    decreases dist[w]
  {
    var i := via[w];
    var l := links[i];
    var next := (if (l.a == w) then l.b else l.a);
    used := (used + [i]);
    persons := (persons + [next]);
    w := next;
  }
  return Connection(true, persons, used, reached);
}
