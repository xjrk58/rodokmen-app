}

function isFollowed(link: ParentLink): bool
{
  ((link.type_ == BIRTH_LINK) || (link.type_ == ADOPTIVE_LINK))
}

lemma isFollowed_ensures(link: ParentLink)
  ensures (isFollowed(link) <==> ((link.type_ == BIRTH_LINK) || (link.type_ == ADOPTIVE_LINK)))
