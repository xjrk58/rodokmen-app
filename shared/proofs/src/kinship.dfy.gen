function comparePersons(a: seq<int>, b: seq<int>): int
{
  if (|a| != |b|) then
    compareInts(|a|, |b|)
  else
    compareFrom(a, b, 0)
}

lemma comparePersons_ensures(a: seq<int>, b: seq<int>)
  ensures (((comparePersons(a, b) == -1) || (comparePersons(a, b) == 0)) || (comparePersons(a, b) == 1))
  ensures ((comparePersons(a, b) == 0) <==> (a == b))
