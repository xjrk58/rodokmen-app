function {:axiom} isStrongLink(link: FamilyLink): bool
  ensures (isStrongLink(link) == exists j: nat :: ((j < |link.confidences|) && (((link.confidences[j] == "normal") || (link.confidences[j] == "high")) || (link.confidences[j] == "very_high"))))

datatype ParentLink = ParentLink(child: int, parent: int, type_: int, couple: int)

datatype PathKey = PathKey(kind: int, degree: int, possible: bool, up: int, down: int, persons: seq<int>)

datatype Chains = Chains(dist: seq<int>, via: seq<int>)

datatype Chain = Chain(persons: seq<int>, links: seq<int>)

datatype Closest = Closest(found: bool, top: int, toFrom: Chain, toTo: Chain, fromUp: Chains, toUp: Chains)

datatype Connection = Connection(found: bool, persons: seq<int>, links: seq<int>, reached: seq<bool>)

datatype FamilyLink = FamilyLink(a: int, b: int, confidences: seq<string>)

datatype PathStep = PathStep(dir: int, couple: int)

function hasDegree(kind: int): bool
{
  ((kind == BIRTH) || (kind == MARRIAGE))
}

function kinshipDegree(kind: int, up: int, down: int): int
  requires (up >= 0)
  requires (down >= 0)
{
  if hasDegree(kind) then
    (up + down)
  else
    NO_DEGREE
}

lemma kinshipDegree_ensures(kind: int, up: int, down: int)
  requires (up >= 0)
  requires (down >= 0)
  ensures (hasDegree(kind) ==> (kinshipDegree(kind, up, down) == (up + down)))
  ensures ((kinshipDegree(kind, up, down) == NO_DEGREE) <==> !(hasDegree(kind)))
  ensures ((((((kind == SELF) || (kind == PARTNER)) || (kind == STEP_SIBLING)) || (kind == CO_PARENT_IN_LAW)) || (kind == FOSTER)) ==> (kinshipDegree(kind, up, down) == NO_DEGREE))
  ensures ((kind == BIRTH) ==> (up == 3) ==> (down == 0) ==> (kinshipDegree(kind, up, down) == 3))
  ensures ((kind == BIRTH) ==> (up == 1) ==> (down == 1) ==> (kinshipDegree(kind, up, down) == 2))
  ensures ((kind == BIRTH) ==> (up == 2) ==> (down == 1) ==> (kinshipDegree(kind, up, down) == 3))
  ensures ((kind == BIRTH) ==> (up == 2) ==> (down == 2) ==> (kinshipDegree(kind, up, down) == 4))
  ensures ((kind == BIRTH) ==> (up == 2) ==> (down == 3) ==> (kinshipDegree(kind, up, down) == 5))
  ensures ((kind == MARRIAGE) ==> (up == 1) ==> (down == 1) ==> (kinshipDegree(kind, up, down) == 2))
  ensures ((kind == MARRIAGE) ==> (up == 0) ==> (down == 1) ==> (kinshipDegree(kind, up, down) == 1))
{
}

function kinshipLine(kind: int, up: int, down: int): int
  requires (up >= 0)
  requires (down >= 0)
{
  if !(hasDegree(kind)) then
    NO_LINE
  else
    if ((up == 0) || (down == 0)) then
      DIRECT
    else
      COLLATERAL
}

lemma kinshipLine_ensures(kind: int, up: int, down: int)
  requires (up >= 0)
  requires (down >= 0)
  ensures ((kinshipLine(kind, up, down) == DIRECT) <==> (hasDegree(kind) && ((up == 0) || (down == 0))))
  ensures ((kinshipLine(kind, up, down) == COLLATERAL) <==> ((hasDegree(kind) && (up > 0)) && (down > 0)))
  ensures ((kinshipLine(kind, up, down) == NO_LINE) <==> !(hasDegree(kind)))
  ensures ((kind == BIRTH) ==> (up == 3) ==> (down == 0) ==> (kinshipLine(kind, up, down) == DIRECT))
  ensures ((kind == BIRTH) ==> (up == 1) ==> (down == 1) ==> (kinshipLine(kind, up, down) == COLLATERAL))
  ensures ((kind == MARRIAGE) ==> (up == 0) ==> (down == 1) ==> (kinshipLine(kind, up, down) == DIRECT))
