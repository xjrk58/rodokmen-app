// Generated by lsc from charts.ts

predicate JSStringLt(s: string, t: string)
  decreases |s|
{
  if |s| == 0 then |t| > 0
  else if |t| == 0 then false
  else if s[0] != t[0] then s[0] < t[0]
  else JSStringLt(s[1..], t[1..])
}

datatype ChildKey = ChildKey(dated: bool, day: int, recorded: int, id: string)

datatype FamilyKey = FamilyKey(dated: bool, day: int, id: string)

// ---- Proof additions: JavaScript's string < is a strict total order (as in edtf.dfy).

lemma JSStringLtAsymmetric(s: string, t: string)
  ensures JSStringLt(s, t) ==> !JSStringLt(t, s)
  decreases |s|
{
  if |s| > 0 && |t| > 0 && s[0] == t[0] {
    JSStringLtAsymmetric(s[1..], t[1..]);
  }
}

lemma JSStringLtTotal(s: string, t: string)
  ensures s == t || JSStringLt(s, t) || JSStringLt(t, s)
  decreases |s|
{
  if |s| > 0 && |t| > 0 && s[0] == t[0] {
    JSStringLtTotal(s[1..], t[1..]);
    if s[1..] == t[1..] {
      assert s == [s[0]] + s[1..] && t == [t[0]] + t[1..];
    }
  }
}

lemma JSStringLtTransitive(s: string, t: string, u: string)
  requires JSStringLt(s, t) && JSStringLt(t, u)
  ensures JSStringLt(s, u)
  decreases |s|
{
  if |s| > 0 && |t| > 0 && |u| > 0 && s[0] == t[0] && t[0] == u[0] {
    JSStringLtTransitive(s[1..], t[1..], u[1..]);
  }
}

// ---- Proof additions: both orders are transitive, so sorting by them gives one order whatever the input order.

lemma compareChildren_transitive(a: ChildKey, b: ChildKey, c: ChildKey)
  ensures compareChildren(a, b) < 0 && compareChildren(b, c) < 0 ==> compareChildren(a, c) < 0
{
  if compareChildren(a, b) < 0 && compareChildren(b, c) < 0 {
    if JSStringLt(a.id, b.id) && JSStringLt(b.id, c.id) {
      JSStringLtTransitive(a.id, b.id, c.id);
    }
  }
}

lemma compareFamilies_transitive(a: FamilyKey, b: FamilyKey, c: FamilyKey)
  ensures compareFamilies(a, b) < 0 && compareFamilies(b, c) < 0 ==> compareFamilies(a, c) < 0
{
  if compareFamilies(a, b) < 0 && compareFamilies(b, c) < 0 {
    if JSStringLt(a.id, b.id) && JSStringLt(b.id, c.id) {
      JSStringLtTransitive(a.id, b.id, c.id);
    }
  }
}

// ---- Proof additions: sums of counts.

lemma SumUpToZeros(xs: seq<int>, n: int)
  requires 0 <= n <= |xs|
  requires forall u: nat :: u < n ==> xs[u] == 0
  ensures sumUpTo(xs, n) == 0
  decreases n
{
  if n > 0 {
    SumUpToZeros(xs, n - 1);
  }
}

lemma SumUpToIncrement(xs: seq<int>, i: int, n: int)
  requires 0 <= i < |xs| && 0 <= n <= |xs|
  ensures sumUpTo(xs[i := xs[i] + 1], n) == sumUpTo(xs, n) + (if i < n then 1 else 0)
  decreases n
{
  if n > 0 {
    SumUpToIncrement(xs, i, n - 1);
  }
}

datatype ChildEdge = ChildEdge(family: int, a: int, b: int, child: int, followed: bool)

datatype Selection = Selection(gen: seq<int>, via: seq<int>, parent: seq<int>)

datatype Line = Line(persons: seq<int>, via: seq<int>, toEnd: seq<int>, down: seq<int>)

datatype Cut = Cut(kept: int, leftOut: seq<int>, total: int)

function compareChildren(a: ChildKey, b: ChildKey): int
{
  if (a.dated != b.dated) then
    if a.dated then
      -1
    else
      1
  else
    if (a.dated && (a.day != b.day)) then
      if (a.day < b.day) then
        -1
      else
        1
    else
      if (a.recorded != b.recorded) then
        if (a.recorded < b.recorded) then
          -1
        else
          1
      else
        if JSStringLt(a.id, b.id) then
          -1
        else
          if JSStringLt(b.id, a.id) then
            1
          else
            0
}

lemma compareChildren_ensures(a: ChildKey, b: ChildKey)
  ensures (compareChildren(a, b) == (-(compareChildren(b, a))))
  ensures (-1 <= compareChildren(a, b))
  ensures (compareChildren(a, b) <= 1)
  ensures ((compareChildren(a, b) == 0) ==> (a.id == b.id))
  ensures (a.dated ==> !(b.dated) ==> (compareChildren(a, b) == -1))
  ensures (a.dated ==> b.dated ==> (a.day < b.day) ==> (compareChildren(a, b) == -1))
  ensures ((a.dated == b.dated) ==> (!(a.dated) || (a.day == b.day)) ==> (a.recorded < b.recorded) ==> (compareChildren(a, b) == -1))
{
  // Proof addition: JavaScript's string < is a strict total order.
  JSStringLtAsymmetric(a.id, b.id);
  JSStringLtTotal(a.id, b.id);
}

function compareFamilies(a: FamilyKey, b: FamilyKey): int
{
  if (a.dated != b.dated) then
    if a.dated then
      -1
    else
      1
  else
    if (a.dated && (a.day != b.day)) then
      if (a.day < b.day) then
        -1
      else
        1
    else
      if JSStringLt(a.id, b.id) then
        -1
      else
        if JSStringLt(b.id, a.id) then
          1
        else
          0
}

lemma compareFamilies_ensures(a: FamilyKey, b: FamilyKey)
  ensures (compareFamilies(a, b) == (-(compareFamilies(b, a))))
  ensures (-1 <= compareFamilies(a, b))
  ensures (compareFamilies(a, b) <= 1)
  ensures ((compareFamilies(a, b) == 0) ==> (a.id == b.id))
  ensures (a.dated ==> !(b.dated) ==> (compareFamilies(a, b) == -1))
  ensures (a.dated ==> b.dated ==> (a.day < b.day) ==> (compareFamilies(a, b) == -1))
{
  // Proof addition: JavaScript's string < is a strict total order.
  JSStringLtAsymmetric(a.id, b.id);
  JSStringLtTotal(a.id, b.id);
}

function dayKey(year: int, month: int, day: int): int
{
  (((year * 10000) + (month * 100)) + day)
}

function diedYoung(hasBirth: bool, birthYear: int, birthMonth: int, birthDay: int, hasDeath: bool, deathKey: int): bool
{
  ((hasBirth && hasDeath) && (deathKey < dayKey((birthYear + 15), birthMonth, birthDay)))
}

lemma diedYoung_ensures(hasBirth: bool, birthYear: int, birthMonth: int, birthDay: int, hasDeath: bool, deathKey: int)
  ensures (diedYoung(hasBirth, birthYear, birthMonth, birthDay, hasDeath, deathKey) == ((hasBirth && hasDeath) && (deathKey < dayKey((birthYear + 15), birthMonth, birthDay))))
  ensures (hasBirth ==> hasDeath ==> (birthYear == 1830) ==> (birthMonth == 3) ==> (birthDay == 2) ==> (deathKey == 18320510) ==> diedYoung(hasBirth, birthYear, birthMonth, birthDay, hasDeath, deathKey))
  ensures ((birthYear == 1828) ==> (birthMonth == 1) ==> (birthDay == 1) ==> (deathKey == 18501231) ==> !(diedYoung(hasBirth, birthYear, birthMonth, birthDay, hasDeath, deathKey)))
  ensures ((!(hasBirth) || !(hasDeath)) ==> !(diedYoung(hasBirth, birthYear, birthMonth, birthDay, hasDeath, deathKey)))
{
}

function goesOn(gen: seq<int>, isStart: seq<bool>, startFamily: int, generations: int, f: int, p: int): bool
  requires (|gen| == |isStart|)
{
  (((((p >= 0) && (p < |gen|)) && (gen[p] >= 1)) && (gen[p] < generations)) && (((startFamily < 0) || (f == startFamily)) || !(isStart[p])))
}

function isReached(s: Selection, edges: seq<ChildEdge>, isStart: seq<bool>, startFamily: int, generations: int, v: int): bool
  requires (0 <= v)
  requires (v < |s.gen|)
  requires (|s.gen| == |s.via|)
  requires (|s.gen| == |s.parent|)
  requires (|s.gen| == |isStart|)
{
  var i := s.via[v];
  if ((i < 0) || (i >= |edges|)) then
    false
  else
    var e := edges[i];
    var p := s.parent[v];
    ((((e.followed && (e.child == v)) && ((p == e.a) || (p == e.b))) && goesOn(s.gen, isStart, startFamily, generations, e.family, p)) && ((s.gen[p] + 1) == s.gen[v]))
}

function mayLeave(start: int, startFamily: int, f: int, p: int): bool
{
  (((startFamily < 0) || (p != start)) || (f == startFamily))
}

function leaves(edges: seq<ChildEdge>, start: int, startFamily: int, from: int, j: int): bool
  requires (0 <= j)
  requires (j < |edges|)
{
  var e := edges[j];
  ((e.followed && ((e.a == from) || (e.b == from))) && mayLeave(start, startFamily, e.family, from))
}

function stepFits(edges: seq<ChildEdge>, toEnd: seq<int>, start: int, startFamily: int, maxGen: int, k: int, from: int, j: int): bool
  requires (0 <= j)
  requires (j < |edges|)
  requires forall i: nat :: ((i < |edges|) ==> ((0 <= edges[i].child) && (edges[i].child < |toEnd|)))
{
  var c := edges[j].child;
  ((leaves(edges, start, startFamily, from, j) && (toEnd[c] >= 0)) && (toEnd[c] <= ((maxGen - 2) - k)))
}

function cardsUpTo(cardsAt: seq<int>, n: int): int
  requires (0 <= n)
  requires (n <= |cardsAt|)
  decreases n
{
  if (n == 0) then
    0
  else
    (cardsUpTo(cardsAt, (n - 1)) + cardsAt[(n - 1)])
}

function sumUpTo(xs: seq<int>, n: int): int
  requires (0 <= n)
  requires (n <= |xs|)
  decreases n
{
  if (n == 0) then
    0
  else
    (sumUpTo(xs, (n - 1)) + xs[(n - 1)])
}

function ancestorIn(gen: seq<int>, parent: seq<int>, kept: int, v: int): int
  requires (|gen| == |parent|)
  requires (0 <= v)
  requires (v < |gen|)
  requires (kept >= 1)
  requires forall u: nat :: ((u < |gen|) ==> (gen[u] >= 2) ==> (((0 <= parent[u]) && (parent[u] < |gen|)) && (gen[parent[u]] == (gen[u] - 1))))
  decreases gen[v]
{
  if (gen[v] <= kept) then
    v
  else
    ancestorIn(gen, parent, kept, parent[v])
}

lemma ancestorIn_ensures(gen: seq<int>, parent: seq<int>, kept: int, v: int)
  requires (|gen| == |parent|)
  requires (0 <= v)
  requires (v < |gen|)
  requires (kept >= 1)
  requires forall u: nat :: ((u < |gen|) ==> (gen[u] >= 2) ==> (((0 <= parent[u]) && (parent[u] < |gen|)) && (gen[parent[u]] == (gen[u] - 1))))
  ensures (0 <= ancestorIn(gen, parent, kept, v))
  ensures (ancestorIn(gen, parent, kept, v) < |gen|)
  ensures ((gen[v] > kept) ==> (gen[ancestorIn(gen, parent, kept, v)] == kept))
  ensures ((gen[v] <= kept) ==> (ancestorIn(gen, parent, kept, v) == v))
  // Proof addition: by induction up the parents.
  decreases gen[v]
{
  if gen[v] > kept {
    ancestorIn_ensures(gen, parent, kept, parent[v]);
  }
}

function leftOutBelow(gen: seq<int>, parent: seq<int>, kept: int, a: int, n: int): int
  requires (|gen| == |parent|)
  requires (0 <= n)
  requires (n <= |gen|)
  requires (kept >= 1)
  requires forall u: nat :: ((u < |gen|) ==> (gen[u] >= 2) ==> (((0 <= parent[u]) && (parent[u] < |gen|)) && (gen[parent[u]] == (gen[u] - 1))))
  decreases n
{
  if (n == 0) then
    0
  else
    (leftOutBelow(gen, parent, kept, a, (n - 1)) + (if ((gen[(n - 1)] > kept) && (ancestorIn(gen, parent, kept, (n - 1)) == a)) then 1 else 0))
}

function leftOutUpTo(gen: seq<int>, kept: int, n: int): int
  requires (0 <= n)
  requires (n <= |gen|)
  decreases n
{
  if (n == 0) then
    0
  else
    (leftOutUpTo(gen, kept, (n - 1)) + (if (gen[(n - 1)] > kept) then 1 else 0))
}

method selectDescendants(count: int, isStart: seq<bool>, startFamily: int, edges: seq<ChildEdge>, generations: int) returns (res: Selection)
  requires (|isStart| == count)
  requires (generations >= 1)
  requires forall i: nat :: ((i < |edges|) ==> ((((((0 <= edges[i].child) && (edges[i].child < count)) && (-1 <= edges[i].a)) && (edges[i].a < count)) && (-1 <= edges[i].b)) && (edges[i].b < count)))
  ensures (|res.gen| == count)
  ensures (|res.via| == count)
  ensures (|res.parent| == count)
  ensures forall v: nat :: ((v < count) ==> ((res.gen[v] == 1) == isStart[v]))
  ensures forall v: nat :: ((v < count) ==> ((0 <= res.gen[v]) && (res.gen[v] <= generations)))
  ensures forall i: nat :: ((i < |edges|) ==> edges[i].followed ==> goesOn(res.gen, isStart, startFamily, generations, edges[i].family, edges[i].a) ==> ((res.gen[edges[i].child] >= 1) && (res.gen[edges[i].child] <= (res.gen[edges[i].a] + 1))))
  ensures forall i: nat :: ((i < |edges|) ==> edges[i].followed ==> goesOn(res.gen, isStart, startFamily, generations, edges[i].family, edges[i].b) ==> ((res.gen[edges[i].child] >= 1) && (res.gen[edges[i].child] <= (res.gen[edges[i].b] + 1))))
  ensures forall v: nat :: ((v < count) ==> (res.gen[v] >= 2) ==> isReached(res, edges, isStart, startFamily, generations, v))
{
  var gen: seq<int> := [];
  var via: seq<int> := [];
  var parent: seq<int> := [];
  var i_start_idx := 0;
  while i_start_idx < |isStart|
    invariant (i_start_idx <= |isStart|)
    invariant (|gen| == i_start_idx)
    invariant (|via| == i_start_idx)
    invariant (|parent| == i_start_idx)
    invariant forall v: nat :: ((v < i_start_idx) ==> (((gen[v] == (if isStart[v] then 1 else 0)) && (via[v] == -1)) && (parent[v] == -1)))
  {
    var start := isStart[i_start_idx];
    gen := (gen + [(if start then 1 else 0)]);
    via := (via + [-1]);
    parent := (parent + [-1]);
    i_start_idx := i_start_idx + 1;
  }
  var level := 1;
  while (level < generations)
    invariant (1 <= level)
    invariant (level <= generations)
    invariant (|gen| == count)
    invariant (|via| == count)
    invariant (|parent| == count)
    invariant forall v: nat :: ((v < count) ==> ((gen[v] == 1) == isStart[v]))
    invariant forall v: nat :: ((v < count) ==> ((0 <= gen[v]) && (gen[v] <= level)))
    invariant forall i: nat :: ((i < |edges|) ==> edges[i].followed ==> goesOn(gen, isStart, startFamily, generations, edges[i].family, edges[i].a) ==> (gen[edges[i].a] < level) ==> ((gen[edges[i].child] >= 1) && (gen[edges[i].child] <= (gen[edges[i].a] + 1))))
    invariant forall i: nat :: ((i < |edges|) ==> edges[i].followed ==> goesOn(gen, isStart, startFamily, generations, edges[i].family, edges[i].b) ==> (gen[edges[i].b] < level) ==> ((gen[edges[i].child] >= 1) && (gen[edges[i].child] <= (gen[edges[i].b] + 1))))
    invariant forall v: nat :: ((v < count) ==> (gen[v] >= 2) ==> isReached(Selection(gen, via, parent), edges, isStart, startFamily, generations, v))
    decreases (generations - level)
  {
    var i := 0;
    while (i < |edges|)
      invariant (0 <= i)
      invariant (i <= |edges|)
      invariant (|gen| == count)
      invariant (|via| == count)
      invariant (|parent| == count)
      invariant forall v: nat :: ((v < count) ==> ((gen[v] == 1) == isStart[v]))
      invariant forall v: nat :: ((v < count) ==> ((0 <= gen[v]) && (gen[v] <= (level + 1))))
      invariant forall j: nat :: ((j < |edges|) ==> edges[j].followed ==> goesOn(gen, isStart, startFamily, generations, edges[j].family, edges[j].a) ==> (gen[edges[j].a] < level) ==> ((gen[edges[j].child] >= 1) && (gen[edges[j].child] <= (gen[edges[j].a] + 1))))
      invariant forall j: nat :: ((j < |edges|) ==> edges[j].followed ==> goesOn(gen, isStart, startFamily, generations, edges[j].family, edges[j].b) ==> (gen[edges[j].b] < level) ==> ((gen[edges[j].child] >= 1) && (gen[edges[j].child] <= (gen[edges[j].b] + 1))))
      invariant forall j: nat :: ((j < i) ==> edges[j].followed ==> goesOn(gen, isStart, startFamily, generations, edges[j].family, edges[j].a) ==> (gen[edges[j].a] == level) ==> ((gen[edges[j].child] >= 1) && (gen[edges[j].child] <= (level + 1))))
      invariant forall j: nat :: ((j < i) ==> edges[j].followed ==> goesOn(gen, isStart, startFamily, generations, edges[j].family, edges[j].b) ==> (gen[edges[j].b] == level) ==> ((gen[edges[j].child] >= 1) && (gen[edges[j].child] <= (level + 1))))
      invariant forall v: nat :: ((v < count) ==> (gen[v] >= 2) ==> isReached(Selection(gen, via, parent), edges, isStart, startFamily, generations, v))
      decreases (|edges| - i)
    {
      var e := edges[i];
      if (e.followed && (gen[e.child] == 0)) {
        var i_t0 := goesOn(gen, isStart, startFamily, generations, e.family, e.a);
        if (i_t0 && (gen[e.a] == level)) {
          gen := gen[e.child := (level + 1)];
          via := via[e.child := i];
          parent := parent[e.child := e.a];
        } else {
          var i_t1 := goesOn(gen, isStart, startFamily, generations, e.family, e.b);
          if (i_t1 && (gen[e.b] == level)) {
            gen := gen[e.child := (level + 1)];
            via := via[e.child := i];
            parent := parent[e.child := e.b];
          }
        }
      }
      i := (i + 1);
    }
    level := (level + 1);
  }
  return Selection(gen, via, parent);
}

method directLine(count: int, edges: seq<ChildEdge>, start: int, startFamily: int, end: int, maxGen: int) returns (res: Line)
  requires (0 <= start)
  requires (start < count)
  requires (0 <= end)
  requires (end < count)
  requires (maxGen >= 1)
  requires forall i: nat :: ((i < |edges|) ==> ((((((0 <= edges[i].child) && (edges[i].child < count)) && (-1 <= edges[i].a)) && (edges[i].a < count)) && (-1 <= edges[i].b)) && (edges[i].b < count)))
  ensures (|res.toEnd| == count)
  ensures (|res.down| == count)
  ensures (res.toEnd[end] == 0)
  ensures forall v: nat :: ((v < count) ==> (((-1 <= res.toEnd[v]) && (res.toEnd[v] <= (maxGen - 1))) && ((v != end) ==> (res.toEnd[v] != 0))))
  ensures forall i: nat :: ((i < |edges|) ==> edges[i].followed ==> (edges[i].a >= 0) ==> mayLeave(start, startFamily, edges[i].family, edges[i].a) ==> (res.toEnd[edges[i].child] >= 0) ==> (res.toEnd[edges[i].child] < (maxGen - 1)) ==> ((res.toEnd[edges[i].a] >= 0) && (res.toEnd[edges[i].a] <= (res.toEnd[edges[i].child] + 1))))
  ensures forall i: nat :: ((i < |edges|) ==> edges[i].followed ==> (edges[i].b >= 0) ==> mayLeave(start, startFamily, edges[i].family, edges[i].b) ==> (res.toEnd[edges[i].child] >= 0) ==> (res.toEnd[edges[i].child] < (maxGen - 1)) ==> ((res.toEnd[edges[i].b] >= 0) && (res.toEnd[edges[i].b] <= (res.toEnd[edges[i].child] + 1))))
  ensures forall v: nat :: ((v < count) ==> (res.toEnd[v] >= 1) ==> ((((0 <= res.down[v]) && (res.down[v] < |edges|)) && leaves(edges, start, startFamily, v, res.down[v])) && (res.toEnd[edges[res.down[v]].child] == (res.toEnd[v] - 1))))
  ensures ((|res.persons| == 0) == (res.toEnd[start] < 0))
  ensures ((|res.persons| > 0) ==> ((((res.persons[0] == start) && (res.persons[(|res.persons| - 1)] == end)) && (|res.via| == (|res.persons| - 1))) && (|res.persons| <= maxGen)))
  ensures ((|res.persons| == 0) ==> (|res.via| == 0))
  ensures forall k: nat :: ((k < |res.via|) ==> ((0 <= res.via[k]) && (res.via[k] < |edges|)))
  ensures forall k: nat :: ((k < |res.via|) ==> (0 <= res.via[k]) ==> (res.via[k] < |edges|) ==> (edges[res.via[k]].child == res.persons[(k + 1)]))
  ensures forall k: nat :: ((k < |res.via|) ==> (0 <= res.via[k]) ==> (res.via[k] < |edges|) ==> stepFits(edges, res.toEnd, start, startFamily, maxGen, k, res.persons[k], res.via[k]))
  ensures forall k: nat :: ((k < |res.via|) ==> forall j: nat :: ((j < res.via[k]) ==> (j < |edges|) ==> !(stepFits(edges, res.toEnd, start, startFamily, maxGen, k, res.persons[k], j))))
{
  var toEnd: seq<int> := [];
  var down: seq<int> := [];
  var v := 0;
  while (v < count)
    invariant (0 <= v)
    invariant (v <= count)
    invariant (|toEnd| == v)
    invariant (|down| == v)
    invariant forall u: nat :: ((u < v) ==> ((toEnd[u] == (if (u == end) then 0 else -1)) && (down[u] == -1)))
    decreases (count - v)
  {
    toEnd := (toEnd + [(if (v == end) then 0 else -1)]);
    down := (down + [-1]);
    v := (v + 1);
  }
  var d := 0;
  while (d < (maxGen - 1))
    invariant (0 <= d)
    invariant (d <= (maxGen - 1))
    invariant (|toEnd| == count)
    invariant (|down| == count)
    invariant (toEnd[end] == 0)
    invariant forall u: nat :: ((u < count) ==> (((-1 <= toEnd[u]) && (toEnd[u] <= d)) && ((u != end) ==> (toEnd[u] != 0))))
    invariant forall i: nat :: ((i < |edges|) ==> edges[i].followed ==> (edges[i].a >= 0) ==> mayLeave(start, startFamily, edges[i].family, edges[i].a) ==> (toEnd[edges[i].child] >= 0) ==> (toEnd[edges[i].child] < d) ==> ((toEnd[edges[i].a] >= 0) && (toEnd[edges[i].a] <= (toEnd[edges[i].child] + 1))))
    invariant forall i: nat :: ((i < |edges|) ==> edges[i].followed ==> (edges[i].b >= 0) ==> mayLeave(start, startFamily, edges[i].family, edges[i].b) ==> (toEnd[edges[i].child] >= 0) ==> (toEnd[edges[i].child] < d) ==> ((toEnd[edges[i].b] >= 0) && (toEnd[edges[i].b] <= (toEnd[edges[i].child] + 1))))
    invariant forall u: nat :: ((u < count) ==> (toEnd[u] >= 1) ==> ((((0 <= down[u]) && (down[u] < |edges|)) && leaves(edges, start, startFamily, u, down[u])) && (toEnd[edges[down[u]].child] == (toEnd[u] - 1))))
    decreases ((maxGen - 1) - d)
  {
    var i := 0;
    while (i < |edges|)
      invariant (0 <= i)
      invariant (i <= |edges|)
      invariant (|toEnd| == count)
      invariant (|down| == count)
      invariant (toEnd[end] == 0)
      invariant forall u: nat :: ((u < count) ==> (((-1 <= toEnd[u]) && (toEnd[u] <= (d + 1))) && ((u != end) ==> (toEnd[u] != 0))))
      invariant forall j: nat :: ((j < |edges|) ==> edges[j].followed ==> (edges[j].a >= 0) ==> mayLeave(start, startFamily, edges[j].family, edges[j].a) ==> (toEnd[edges[j].child] >= 0) ==> (toEnd[edges[j].child] < d) ==> ((toEnd[edges[j].a] >= 0) && (toEnd[edges[j].a] <= (toEnd[edges[j].child] + 1))))
      invariant forall j: nat :: ((j < |edges|) ==> edges[j].followed ==> (edges[j].b >= 0) ==> mayLeave(start, startFamily, edges[j].family, edges[j].b) ==> (toEnd[edges[j].child] >= 0) ==> (toEnd[edges[j].child] < d) ==> ((toEnd[edges[j].b] >= 0) && (toEnd[edges[j].b] <= (toEnd[edges[j].child] + 1))))
      invariant forall j: nat :: ((j < i) ==> edges[j].followed ==> (edges[j].a >= 0) ==> mayLeave(start, startFamily, edges[j].family, edges[j].a) ==> (toEnd[edges[j].child] == d) ==> ((toEnd[edges[j].a] >= 0) && (toEnd[edges[j].a] <= (d + 1))))
      invariant forall j: nat :: ((j < i) ==> edges[j].followed ==> (edges[j].b >= 0) ==> mayLeave(start, startFamily, edges[j].family, edges[j].b) ==> (toEnd[edges[j].child] == d) ==> ((toEnd[edges[j].b] >= 0) && (toEnd[edges[j].b] <= (d + 1))))
      invariant forall u: nat :: ((u < count) ==> (toEnd[u] >= 1) ==> ((((0 <= down[u]) && (down[u] < |edges|)) && leaves(edges, start, startFamily, u, down[u])) && (toEnd[edges[down[u]].child] == (toEnd[u] - 1))))
      decreases (|edges| - i)
    {
      var e := edges[i];
      if (e.followed && (toEnd[e.child] == d)) {
        var i_t2 := mayLeave(start, startFamily, e.family, e.a);
        if (((e.a >= 0) && (toEnd[e.a] == -1)) && i_t2) {
          toEnd := toEnd[e.a := (d + 1)];
          down := down[e.a := i];
        }
        var i_t3 := mayLeave(start, startFamily, e.family, e.b);
        if (((e.b >= 0) && (toEnd[e.b] == -1)) && i_t3) {
          toEnd := toEnd[e.b := (d + 1)];
          down := down[e.b := i];
        }
      }
      i := (i + 1);
    }
    d := (d + 1);
  }
  var persons: seq<int> := [];
  var via: seq<int> := [];
  if (toEnd[start] < 0) {
    return Line(persons, via, toEnd, down);
  }
  persons := (persons + [start]);
  var cur := start;
  var k := 0;
  while (cur != end)
    invariant (0 <= cur)
    invariant (cur < count)
    invariant (|persons| == (k + 1))
    invariant (|via| == k)
    invariant (persons[0] == start)
    invariant (persons[k] == cur)
    invariant (0 <= toEnd[cur])
    invariant (toEnd[cur] <= ((maxGen - 1) - k))
    invariant forall m: nat :: ((m < k) ==> ((0 <= via[m]) && (via[m] < |edges|)))
    invariant forall m: nat :: ((m < k) ==> (0 <= via[m]) ==> (via[m] < |edges|) ==> (edges[via[m]].child == persons[(m + 1)]))
    invariant forall m: nat :: ((m < k) ==> (0 <= via[m]) ==> (via[m] < |edges|) ==> stepFits(edges, toEnd, start, startFamily, maxGen, m, persons[m], via[m]))
    invariant forall m: nat :: ((m < k) ==> forall j: nat :: ((j < via[m]) ==> (j < |edges|) ==> !(stepFits(edges, toEnd, start, startFamily, maxGen, m, persons[m], j))))
    decreases ((maxGen - 1) - k)
  {
    assert (toEnd[cur] >= 1);
    assert stepFits(edges, toEnd, start, startFamily, maxGen, k, cur, down[cur]);
    var found := -1;
    var i := 0;
    while ((i < |edges|) && (found < 0))
      invariant (0 <= i)
      invariant (i <= |edges|)
      invariant ((found < 0) ==> forall j: nat :: ((j < i) ==> !(stepFits(edges, toEnd, start, startFamily, maxGen, k, cur, j))))
      invariant ((found >= 0) ==> (((found < |edges|) && stepFits(edges, toEnd, start, startFamily, maxGen, k, cur, found)) && forall j: nat :: ((j < found) ==> !(stepFits(edges, toEnd, start, startFamily, maxGen, k, cur, j)))))
      decreases (|edges| - i)
    {
      var i_t4 := stepFits(edges, toEnd, start, startFamily, maxGen, k, cur, i);
      if i_t4 {
        found := i;
      }
      i := (i + 1);
    }
    assert (found >= 0);
    var next := edges[found].child;
    ghost var before: seq<int> := persons;
    ghost var viaBefore: seq<int> := via;
    persons := (persons + [next]);
    via := (via + [found]);
    assert forall m: nat :: ((m < |before|) ==> (persons[m] == before[m]));
    assert forall m: nat :: ((m < |viaBefore|) ==> (via[m] == viaBefore[m]));
    assert (((persons[(k + 1)] == next) && (via[k] == found)) && (persons[k] == cur));
    cur := next;
    k := (k + 1);
  }
  return Line(persons, via, toEnd, down);
}

method cutToSize(count: int, gen: seq<int>, parent: seq<int>, cardsAt: seq<int>, limit: int) returns (res: Cut)
  requires (|gen| == count)
  requires (|parent| == count)
  requires (|cardsAt| >= 2)
  requires forall u: nat :: ((u < count) ==> ((0 <= gen[u]) && (gen[u] <= |cardsAt|)))
  requires forall u: nat :: ((u < count) ==> (gen[u] >= 2) ==> (((0 <= parent[u]) && (parent[u] < count)) && (gen[parent[u]] == (gen[u] - 1))))
  ensures (2 <= res.kept)
  ensures (res.kept <= |cardsAt|)
  ensures ((res.kept == 2) || (cardsUpTo(cardsAt, res.kept) <= limit))
  ensures ((res.kept == |cardsAt|) || (cardsUpTo(cardsAt, (res.kept + 1)) > limit))
  ensures (|res.leftOut| == count)
  ensures forall a: nat :: ((a < count) ==> (res.leftOut[a] == leftOutBelow(gen, parent, res.kept, a, count)))
  ensures forall a: nat :: ((a < count) ==> (res.leftOut[a] > 0) ==> (gen[a] == res.kept))
  ensures (res.total == leftOutUpTo(gen, res.kept, count))
  ensures (sumUpTo(res.leftOut, count) == res.total)
{
  var kept := 2;
  while ((kept < |cardsAt|) && (cardsUpTo(cardsAt, (kept + 1)) <= limit))
    invariant (2 <= kept)
    invariant (kept <= |cardsAt|)
    invariant ((kept == 2) || (cardsUpTo(cardsAt, kept) <= limit))
    decreases (|cardsAt| - kept)
  {
    kept := (kept + 1);
  }
  var leftOut: seq<int> := [];
  var a := 0;
  while (a < count)
    invariant (0 <= a)
    invariant (a <= count)
    invariant (|leftOut| == a)
    invariant forall u: nat :: ((u < a) ==> (leftOut[u] == 0))
    decreases (count - a)
  {
    leftOut := (leftOut + [0]);
    a := (a + 1);
  }
  assert forall u: nat :: ((u < count) ==> (leftOut[u] == leftOutBelow(gen, parent, kept, u, 0)));
  // Proof addition: no one counted yet.
  SumUpToZeros(leftOut, count);
  var total := 0;
  var v := 0;
  while (v < count)
    invariant (0 <= v)
    invariant (v <= count)
    invariant (|leftOut| == count)
    invariant forall u: nat :: ((u < count) ==> (leftOut[u] == leftOutBelow(gen, parent, kept, u, v)))
    invariant (total == leftOutUpTo(gen, kept, v))
    invariant (sumUpTo(leftOut, count) == total)
    invariant forall u: nat :: ((u < count) ==> (leftOut[u] > 0) ==> (gen[u] == kept))
    decreases (count - v)
  {
    if (gen[v] > kept) {
      var i_t5 := ancestorIn(gen, parent, kept, v);
      var top := i_t5;
      // Proof addition: the ancestor is in the last generation kept.
      ancestorIn_ensures(gen, parent, kept, v);
      ghost var before: seq<int> := leftOut;
      leftOut := leftOut[top := (leftOut[top] + 1)];
      // Proof addition: one more counted.
      SumUpToIncrement(before, top, count);
      total := (total + 1);
    }
    v := (v + 1);
  }
  return Cut(kept, leftOut, total);
}
