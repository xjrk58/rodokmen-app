{
  "name": "@rodokmen/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Rodokmen data model: Zod schemas, the EDTF-subset date parser and the Living rule, shared by app and server",
  "type": "module",
  "exports": {
    ".": {
      "@rodokmen/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
