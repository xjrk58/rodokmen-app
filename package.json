{
  "name": "rodokmen",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:scripts": "node --test 'scripts/test/*.test.mjs'",
    "verify": "pnpm --filter @rodokmen/shared verify",
    "verify:trace": "node scripts/verification-trace.mjs",
    "lint": "pnpm run lint:js && pnpm run lint:sh",
    "lint:js": "eslint --max-warnings 0 .",
    "lint:sh": "node scripts/shellcheck.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vault-guard": "node scripts/vault-guard.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "globals": "17.13.0",
    "jscpd": "5.4.2",
    "knip": "5.88.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
