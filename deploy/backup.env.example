# /opt/rodokmen/backup.env on the VPS (mode 600). Only the backup job reads it.

# restic repository at the second EU provider (S3-compatible), and its encryption password.
# Keep RESTIC_PASSWORD also in a password manager: without it the Backups cannot be read.
RESTIC_REPOSITORY=s3:https://s3.second-provider.example.eu/rodokmen-backup
RESTIC_PASSWORD=change-me-long-random
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The images come from Garage with the read-only key in .env (IMAGES_BACKUP_KEY_ID); the
# compose file builds that source (IMAGES_SOURCE) itself.
