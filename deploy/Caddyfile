# One domain over HTTPS (ADR 0007). Caddy gets and renews the certificate itself and
# redirects plain HTTP to HTTPS on the same path.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# The MCP server (add-agent-access) for AI assistants with an Agent token. Its answers may
	# be streamed (server-sent events), so they go out at once and uncompressed.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy {$MCP_UPSTREAM:mcp:3001} {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip

		# api-blue and api-green both answer to "api" on the internal network; during a deploy
		# both may run, afterwards only the healthy one. Retry briefly while they switch.
		reverse_proxy {$UPSTREAM:api:3000} {
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 5s
		}
	}
}
