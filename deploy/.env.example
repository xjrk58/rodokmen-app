# /opt/rodokmen/.env on the VPS (mode 600). Read by docker compose for the API, the watchdog
# and variable substitution. Every variable is explained in deploy/README.md.

# --- domain and database
# The app and the API are served at https://$DOMAIN, image links at https://files.$DOMAIN.
DOMAIN=rodokmen.dev
ACME_EMAIL=owner@example.eu
POSTGRES_PASSWORD=change-me-long-random

# --- email (an EU transactional service, SMTP with STARTTLS on 587 or TLS on 465)
MAIL_TRANSPORT=smtp
MAIL_FROM=Rodokmen <noreply@rodokmen.dev>
SMTP_HOST=smtp.example-eu-mail.eu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# The Owner's address for alerts (failing health check, failed Backup, failed deploy).
ALERT_EMAIL=owner@example.eu

# --- images: Garage on the VPS (docker-compose.yml sets the endpoint, region and bucket).
# Generate each value once and keep it: Garage sets up the keys on its first start.
#   key ids:           echo "GK$(openssl rand -hex 12)"
#   secrets, RPC:      openssl rand -hex 32
# The API's key (read and write):
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The Backup job's key (read only; scripts/storage-init.sh grants it):
IMAGES_BACKUP_KEY_ID=
IMAGES_BACKUP_SECRET_KEY=
# Garage's internal RPC secret:
GARAGE_RPC_SECRET=

# --- optional
# SESSION_IDLE_DAYS=90
# Scan reading (README.md, "Scan reading"): without a key it cannot be switched on. Pages the
# Owner allows to be read go to Anthropic's API; the key never leaves this server.
# ANTHROPIC_API_KEY=
# RODOKMEN_SCAN_MODEL=claude-opus-5-5
# RODOKMEN_SCAN_EFFORT=high

# --- nightly Export to rodokmen-export (README.md, "Nightly Export"): OFF unless set to true.
# On, every night at 04:00 Prague time the Tree (Living people reduced, no images) is pushed to the
# private repository with a deploy key that may write to it alone. Leave it off until the
# repository, the key and known_hosts are in place.
# RODOKMEN_EXPORT_ENABLED=false
# RODOKMEN_EXPORT_REPO=git@github.com:<owner>/rodokmen-export.git
# RODOKMEN_EXPORT_BRANCH=main
# RODOKMEN_EXPORT_SSH_KEY=/run/rodokmen-export/deploy_key
# RODOKMEN_EXPORT_KNOWN_HOSTS=/run/rodokmen-export/known_hosts
