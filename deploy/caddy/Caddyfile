# One domain over HTTPS (ADR 0007), plus files.<domain> for image links. Caddy gets and renews
# the certificates itself and redirects plain HTTP to HTTPS on the same path.
{
	email {$ACME_EMAIL}
}

# The API runs in two slots, api-blue and api-green: a deploy starts the new release in the idle
# slot and switches to it once it is healthy (scripts/deploy.sh). New requests go to api-green
# while the file /srv/api-slot/green exists (state/api-slot/green on the host), otherwise to
# api-blue. Caddy looks for it on every request, so a switch needs no reload, and requests already
# on their way to the old slot finish there before deploy.sh stops it.
#
# Retries: when no connection to the slot could be made, as while it restarts, a request is tried
# again for up to 10 s, whatever its method: nothing was sent yet. When the request was sent and
# then failed, only a GET is tried again (Caddy's default), since a POST may already have taken
# effect.
#
# Idle connections (#90): Caddy closes a connection to the API after 60 s without a request, before
# the API would (72 s, keepAliveTimeout in server/src/app.ts, and Node waits 1 s more). Otherwise
# Caddy could send a request on a connection at the moment the API closes it, and a POST would
# fail with 502. Caddy's clock starts only once it has read the whole answer, the API's once it has
# written it, so the margin of over 12 s also covers the end of a large answer still on its way.
# server/test/proxy.test.ts checks that Caddy's time stays the shorter.
(api-slot) {
	reverse_proxy api-{args[0]}:3000 {
		lb_try_duration 10s
		lb_try_interval 250ms
		transport http {
			keepalive 60s
		}
	}
}

(api) {
	@green file {
		root /srv/api-slot
		try_files green
	}
	handle @green {
		import api-slot green
	}
	handle {
		import api-slot blue
	}
}

{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Only where the API sent none: the app's files go out with no-referrer and their
		# Content-Security-Policy, which the API sets itself so that they apply everywhere.
		?Referrer-Policy "same-origin"
		-Server
	}

	# The MCP server (add-agent-access) for AI assistants with an Agent token. Its answers may
	# be streamed (server-sent events), so they go out at once and uncompressed.
	#
	# Each deploy replaces its one container (#89). On SIGTERM the old server first fails its health
	# check for 1 s while it still accepts and answers requests, and Caddy, which checks every
	# 250 ms, stops sending it requests. Only then does the server stop accepting connections (the
	# kernel would reset one still waiting to be accepted), answer the requests it has, and exit
	# (server/mcp/src/shutdown.ts). Until the new server passes the health check, Caddy holds each
	# request and tries again every 250 ms for up to 30 s, whatever its method: nothing was sent yet.
	# Every request gets a new connection (keepalive off). A server can close an idle connection
	# only at a moment when Caddy may be sending a request on it, which would then fail with 502;
	# with one request per connection there is none to close. Inside the Docker network a new
	# connection costs little.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy {$MCP_UPSTREAM:mcp:3001} {
			flush_interval -1
			lb_try_duration 30s
			lb_try_interval 250ms
			health_uri /mcp/health
			health_interval 250ms
			transport http {
				keepalive off
			}
		}
	}

	handle {
		encode zstd gzip
		import api
	}
}

# The API inside the Docker network, for the MCP server: Caddy answers to "api" there
# (docker-compose.yml), so these calls follow the same switch. No port is published for it.
http://api:3000 {
	import api
}

# Image links (README.md, "Image links"). The API signs every presigned link for this host, and
# Caddy hands the request to Garage unchanged (same Host, same path, same query), so the
# signature still matches. Garage refuses anything unsigned or expired. The session cookie is
# host-only, so it is never sent here.
files.{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# An image opened on its own can never act as a page.
		Content-Security-Policy "sandbox"
		# The app uploads with fetch() from its own origin; nothing else may read the answers.
		Access-Control-Allow-Origin "https://{$DOMAIN}"
		-Server
	}

	# Before a cross-origin PUT the browser asks first. Garage has no CORS rules, Caddy answers.
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Methods "GET, HEAD, PUT"
		header Access-Control-Allow-Headers "content-type"
		header Access-Control-Max-Age "3600"
		respond 204
	}

	# Objects of the image bucket only: read, or written once through an upload link (at most 25 MB).
	@object {
		method GET HEAD PUT
		path /rodokmen-images/*
	}
	handle @object {
		request_body {
			max_size 26MiB
		}
		reverse_proxy garage:3900
	}

	handle {
		respond 404
	}
}
