#!/bin/sh
# Refuse pushes that would publish names from the private Vault (scripts/vault-guard.mjs, issues #36 and #51):
# in any commit not yet on the remote (each one, not just the net change), its file names and message, or in the
# names of the pushed branches and tags. Git passes the remote's name as $1 and one line per pushed ref on stdin,
# which the guard reads.
exec node "$(git rev-parse --show-toplevel)/scripts/vault-guard.mjs" --pre-push "$1"
