#!/bin/sh
# Refuse pushes whose commits add names from the private Vault (scripts/vault-guard.mjs, issue #36).
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" per ref on stdin.
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then
    # New branch: check what it adds on top of the remote's main.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    range=${base:+$base..}$local_sha
  else
    range=$remote_sha..$local_sha
  fi
  node "$root/scripts/vault-guard.mjs" --range "$range" || status=1
done
exit $status
