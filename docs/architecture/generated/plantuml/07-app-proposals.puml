@startuml
title <size:24>App (PWA): Proposals, Drafts and review</size>\n<size:24>Proposal, Draft and review screens and the API components they call (add-proposals-and-review).</size>

set separator none
top to bottom direction

skinparam {
}

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

!include ../../legend.puml

AddElementTag("Container,Built,Data store", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Component,Built", $bgColor="#85bbf0", $borderColor="#5d82a8", $fontColor="#000000", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")

AddRelTag("Built", $textColor="#555555", $lineColor="#555555", $lineStyle = "")

AddBoundaryTag("Container,Built,Browser", $bgColor="#ffffff", $borderColor="#2e6295", $fontColor="#2e6295", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddBoundaryTag("Container,Built", $bgColor="#ffffff", $borderColor="#2e6295", $fontColor="#2e6295", $shadowing="", $borderStyle="solid", $borderThickness="2")

System_Boundary("Rodokmen_boundary", "Rodokmen", $tags="Software System,Built") {
  Container_Boundary("Rodokmen.APIserver_boundary", "API server", $tags="Container,Built") {
    Component(Rodokmen.APIserver.TreereadAPI, "Tree read API", $techn="Recursive SQL, PostGIS", $descr="Person search across Names with the relation filter, records, ancestors, descendants and the hourglass, and Events for a map area, years or a Place.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Proposals, "Proposals", $techn="shared/src/schemas/proposals.ts", $descr="Takes Proposals as typed operations with base versions; requires a Citation; private until accepted.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Review, "Review", $techn="shared/src/schemas/review.ts", $descr="Accepts or rejects a whole Proposal in one transaction, with corrections, conflicts and merges.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Historyandundo, "History and undo", $techn="Kysely", $descr="Append-only log of every change before and after, record history, and undo of a whole Proposal.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Evidencemedia, "Evidence media", $techn="sharp, S3 presigner", $descr="Presigned upload and view links; checks uploads one at a time, keeps the checked bytes and makes a 2,000-pixel WebP copy.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Notificationsanddailyjobs, "Notifications and daily jobs", $techn="In-process scheduler, Prague time", $descr="Editors' digest at 18:00, outcome emails, and deleting images of rejected Proposals after 30 days.", $tags="Component,Built", $link="")
  }

  Container_Boundary("Rodokmen.AppPWA_boundary", "App (PWA)", $tags="Container,Built,Browser") {
    Component(Rodokmen.AppPWA.Proposalforms, "Proposal forms", $techn="app/src/propose-form.js, pickers.js", $descr="Phone-first forms that turn one finding into typed operations with a Citation and photos.", $tags="Component,Built", $link="")
    Component(Rodokmen.AppPWA.Drafts, "Drafts", $techn="app/src/drafts.js", $descr="Keeps Drafts and their photos on the device until the Member submits them.", $tags="Component,Built", $link="")
    Component(Rodokmen.AppPWA.DraftslistandmyProposals, "Drafts list and my Proposals", $techn="app/src/work.js, api.js", $descr="Submits Drafts once online and shows each Proposal's status and the Editor's note.", $tags="Component,Built", $link="")
    Component(Rodokmen.AppPWA.Reviewandhistoryscreens, "Review and history screens", $techn="app/src/review.js", $descr="Review queue with conflicts and corrections, merging, record history and undo; Agent work is labelled.", $tags="Component,Built", $link="")
  }

  ContainerDb(Rodokmen.Ondevicestore, "On-device store", $techn="IndexedDB", $descr="Drafts with their photos until submitted, and up to 400 last-loaded Tree records; emptied on sign-out.", $tags="Container,Built,Data store", $link="")
  ContainerDb(Rodokmen.Imagebucket, "Image bucket", $techn="Garage (S3-compatible), on the VPS", $descr="Private page images, photos and portraits: originals, display copies, and pending/ uploads. Reached by browsers only with presigned links at files.<domain>.", $tags="Container,Built,Data store", $link="")
}

Rel(Rodokmen.AppPWA.Proposalforms, Rodokmen.APIserver.TreereadAPI, "Looks up Persons, Places and Sources to link", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.Proposalforms, Rodokmen.AppPWA.Drafts, "Saves each finding as a Draft", $techn="JS call", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.Drafts, Rodokmen.Ondevicestore, "Keeps Drafts and photos as blobs", $techn="IndexedDB", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.DraftslistandmyProposals, Rodokmen.AppPWA.Drafts, "Lists Drafts; warns about old ones", $techn="JS call", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.DraftslistandmyProposals, Rodokmen.APIserver.Evidencemedia, "Gets an upload link per photo, then completes it", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.DraftslistandmyProposals, Rodokmen.Imagebucket, "Uploads each photo to pending/", $techn="HTTPS PUT, presigned link", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.DraftslistandmyProposals, Rodokmen.APIserver.Proposals, "Submits with an idempotency key; lists my Proposals", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.DraftslistandmyProposals, Rodokmen.APIserver.Notificationsanddailyjobs, "Turns outcome emails on or off", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.Reviewandhistoryscreens, Rodokmen.APIserver.Review, "Loads the queue; accepts, rejects or merges", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.Reviewandhistoryscreens, Rodokmen.APIserver.Historyandundo, "Shows record history; undoes a Proposal", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.Reviewandhistoryscreens, Rodokmen.Imagebucket, "Shows Citation images", $techn="HTTPS GET, presigned link", $tags="Built", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml