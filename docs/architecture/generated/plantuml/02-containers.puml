@startuml
title <size:24>Rodokmen: Containers (request path)</size>\n<size:24>The request path: from the browser to the API, the database and the image bucket.</size>

set separator none
top to bottom direction

skinparam {
}

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

!include ../../legend.puml

AddElementTag("Software System,External,Built", $bgColor="#8c8c8c", $borderColor="#616161", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Container,Planned", $bgColor="#ffffff", $borderColor="#777777", $fontColor="#555555", $sprite="", $shadowing="", $borderStyle="dashed", $borderThickness="2")
AddElementTag("Container,In progress,Data store", $bgColor="#438dd5", $borderColor="#c25e00", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="dotted", $borderThickness="6")
AddElementTag("Container,Built,Browser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Container,Built", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Person,Planned", $bgColor="#ffffff", $borderColor="#777777", $fontColor="#555555", $sprite="", $shadowing="", $borderStyle="dashed", $borderThickness="2")
AddElementTag("Container,Built,Data store", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Person,Built", $bgColor="#08427b", $borderColor="#052e56", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Software System,External,Planned", $bgColor="#ffffff", $borderColor="#777777", $fontColor="#555555", $sprite="", $shadowing="", $borderStyle="dashed", $borderThickness="2")

AddRelTag("Built", $textColor="#555555", $lineColor="#555555", $lineStyle = "")
AddRelTag("Planned", $textColor="#8a8a8a", $lineColor="#8a8a8a", $lineStyle = DashedLine())
AddRelTag("In progress", $textColor="#c25e00", $lineColor="#c25e00", $lineStyle = DottedLine())

AddBoundaryTag("Software System,Built", $bgColor="#ffffff", $borderColor="#0b4884", $fontColor="#0b4884", $shadowing="", $borderStyle="solid", $borderThickness="2")

Person(Visitor, "Visitor", $descr="Anyone using the public map without an account.", $tags="Person,Built", $link="")
Person(Contributor, "Contributor", $descr="A Member who reads the Tree and submits Proposals; every new Member starts here.", $tags="Person,Built", $link="")
Person(Editor, "Editor", $descr="A Member who reviews Proposals and may change the Tree directly.", $tags="Person,Built", $link="")
Person(Owner, "Owner", $descr="The one Member who invites Members, assigns roles and keeps the Backups.", $tags="Person,Built", $link="")
Person(Agent, "Agent", $descr="An AI assistant with its own Owner-issued account that contributes only through Proposals.", $tags="Person,Planned", $link="")
System(Archiveportals, "Archive portals", $descr="Online parish-register viewers of the archives that hold the registers of the Czech lands.", $tags="Software System,External,Built", $link="")
System(Historicalmapservices, "Historical map services", $descr="Public services for 19th-century maps of the Czech lands, run by several providers.", $tags="Software System,External,Built", $link="")
System(OpenStreetMaptiles, "OpenStreetMap tiles", $descr="Today's base map; used without prefetching and with attribution.", $tags="Software System,External,Built", $link="")
System(EUemailservice, "EU email service", $descr="Transactional email provider in the EU, sending from the Rodokmen domain.", $tags="Software System,External,Built", $link="")
System(AnthropicClaudeAPI, "Anthropic Claude API", $descr="Reads scan images: returns a transcription and the facts it finds.", $tags="Software System,External,Planned", $link="")

System_Boundary("Rodokmen_boundary", "Rodokmen", $tags="Software System,Built") {
  AddBoundaryTag("In the browser", $borderColor="#999999", $fontColor="#999999", $borderStyle="dashed")
  Boundary(group_1, "In the browser", $tags="In the browser") {
    Container(Rodokmen.Serviceworker, "Service worker", $techn="Service Worker, Cache Storage", $descr="Precaches the app and reference data per release and keeps up to 2,000 viewed tiles, so the map works offline.", $tags="Container,Built", $link="")
    ContainerDb(Rodokmen.Ondevicestore, "On-device store", $techn="IndexedDB", $descr="Drafts with their photos until submitted; later also the last-loaded Tree records.", $tags="Container,In progress,Data store", $link="")
    Container(Rodokmen.AppPWA, "App (PWA)", $techn="HTML, CSS, ES modules checked by tsc, vendored Leaflet 1.9", $descr="The only interface: the map for anyone; for Members a Tree home, Proposals and review.", $tags="Container,Built,Browser", $link="")
  }

  ContainerDb(Rodokmen.Referencedata, "Reference data", $techn="JSON and GeoJSON in app/data/", $descr="Districts, Municipalities, archives with portal links, and map layers, built from public sources.", $tags="Container,Built,Data store", $link="")
  Container(Rodokmen.Reverseproxy, "Reverse proxy", $techn="Caddy 2", $descr="Serves the one domain over HTTPS with automatic certificates and forwards to the active API slot.", $tags="Container,Built", $link="")
  Container(Rodokmen.APIserver, "API server", $techn="TypeScript on Node 22, Fastify, Zod, Kysely", $descr="Serves the app, the sign-in pages and the JSON API; runs the daily jobs.", $tags="Container,Built", $link="")
  Container(Rodokmen.MCPserver, "MCP server", $techn="TypeScript, MCP SDK; stdio or streamable HTTP", $descr="Lets AI assistants search the Tree and submit Proposals; a thin client of the API.", $tags="Container,Planned", $link="")
  ContainerDb(Rodokmen.Database, "Database", $techn="PostgreSQL 16 with PostGIS 3.4", $descr="The Tree, accounts and sessions, Proposals and the log of accepted changes; the source of truth.", $tags="Container,Built,Data store", $link="")
  ContainerDb(Rodokmen.Imagebucket, "Image bucket", $techn="S3-compatible object storage", $descr="Private page images, photos and portraits: originals, display copies, and pending/ uploads.", $tags="Container,Built,Data store", $link="")
}

Rel(Visitor, Rodokmen.AppPWA, "Searches Municipalities, opens place sheets and archive links", $techn="Browser", $tags="Built", $link="")
Rel(Contributor, Rodokmen.AppPWA, "Signs in, writes Drafts offline and submits Proposals", $techn="Browser", $tags="In progress", $link="")
Rel(Editor, Rodokmen.AppPWA, "Reviews Proposals, resolves conflicts, merges and undoes", $techn="Browser", $tags="In progress", $link="")
Rel(Owner, Rodokmen.APIserver, "Invites Members, assigns roles and disables accounts", $techn="JSON/HTTPS API, no app screens yet", $tags="Built", $link="")
Rel(Agent, Rodokmen.MCPserver, "Searches the Tree and submits Proposals", $techn="MCP: stdio, or streamable HTTP at /mcp", $tags="Planned", $link="")
Rel(Rodokmen.AppPWA, Rodokmen.Serviceworker, "Fetches the app, data and tiles through it", $techn="Service Worker API", $tags="Built", $link="")
Rel(Rodokmen.AppPWA, Rodokmen.Referencedata, "Loads borders, Municipalities, archives and layers", $techn="JSON, GeoJSON", $tags="Built", $link="")
Rel(Rodokmen.AppPWA, Rodokmen.Ondevicestore, "Keeps Drafts and photos; later caches Tree records", $techn="IndexedDB", $tags="In progress", $link="")
Rel(Rodokmen.AppPWA, Rodokmen.Reverseproxy, "Loads the app and calls the JSON API", $techn="HTTPS, session cookie", $tags="Built", $link="")
Rel(Rodokmen.AppPWA, Rodokmen.Imagebucket, "Uploads photos and shows images", $techn="HTTPS PUT and GET, presigned links", $tags="In progress", $link="")
Rel(Rodokmen.AppPWA, Archiveportals, "Opens the archive's register viewer", $techn="HTTPS link, new browser context", $tags="Built", $link="")
Rel(Rodokmen.AppPWA, Historicalmapservices, "Shows survey overlays; links to map viewers", $techn="WMS 1.3.0, HTTPS links", $tags="Built", $link="")
Rel(Rodokmen.Serviceworker, Rodokmen.Referencedata, "Precaches with each release", $techn="Cache Storage", $tags="Built", $link="")
Rel(Rodokmen.Serviceworker, OpenStreetMaptiles, "Fetches tiles not yet cached, keeping at most 2,000", $techn="HTTPS", $tags="Built", $link="")
Rel(Rodokmen.Reverseproxy, Rodokmen.APIserver, "Forwards every request to the active API slot", $techn="HTTP, port 3000", $tags="Built", $link="")
Rel(Rodokmen.Reverseproxy, Rodokmen.MCPserver, "Forwards /mcp", $techn="Streamable HTTP", $tags="Planned", $link="")
Rel(Rodokmen.MCPserver, Rodokmen.APIserver, "Calls the API with the Agent's token", $techn="JSON/HTTPS", $tags="Planned", $link="")
Rel(Rodokmen.APIserver, Rodokmen.Database, "Reads and writes the Tree, accounts and sessions", $techn="SQL", $tags="Built", $link="")
Rel(Rodokmen.APIserver, Rodokmen.Database, "Stores Proposals; applies accepted ones with the log in one transaction", $techn="SQL", $tags="In progress", $link="")
Rel(Rodokmen.APIserver, Rodokmen.Imagebucket, "Presigns view links for images", $techn="S3 API", $tags="Built", $link="")
Rel(Rodokmen.APIserver, Rodokmen.Imagebucket, "Checks uploads, writes display copies, moves and deletes images", $techn="S3 API", $tags="In progress", $link="")
Rel(Rodokmen.APIserver, EUemailservice, "Sends invitations and sign-in links", $techn="SMTP, STARTTLS", $tags="Built", $link="")
Rel(Rodokmen.APIserver, AnthropicClaudeAPI, "Sends uploaded scans for reading", $techn="HTTPS, API key", $tags="Planned", $link="")
Rel(Rodokmen.APIserver, EUemailservice, "Sends the Editors' digest and outcome emails", $techn="SMTP, STARTTLS", $tags="In progress", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml