@startuml
title <size:24>API server: Proposals, review and history</size>\n<size:24>The only write path into the Tree (add-proposals-and-review), and the relation to the family it keeps up to date.</size>

set separator none
left to right direction

skinparam {
}

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

!include ../../legend.puml

AddElementTag("Software System,External,Built", $bgColor="#8c8c8c", $borderColor="#616161", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Container,Built,Data store", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Component,Built", $bgColor="#85bbf0", $borderColor="#5d82a8", $fontColor="#000000", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")

AddRelTag("Built", $textColor="#555555", $lineColor="#555555", $lineStyle = "")

AddBoundaryTag("Container,Built,Browser", $bgColor="#ffffff", $borderColor="#2e6295", $fontColor="#2e6295", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddBoundaryTag("Container,Built", $bgColor="#ffffff", $borderColor="#2e6295", $fontColor="#2e6295", $shadowing="", $borderStyle="solid", $borderThickness="2")

System(EUemailservice, "EU email service", $descr="Transactional email provider in the EU, sending from the Rodokmen domain.", $tags="Software System,External,Built", $link="")

System_Boundary("Rodokmen_boundary", "Rodokmen", $tags="Software System,Built") {
  Container_Boundary("Rodokmen.APIserver_boundary", "API server", $tags="Container,Built") {
    Component(Rodokmen.APIserver.Familyrootsandrelation, "Family roots and relation", $techn="Proved rule in shared/, advisory lock", $descr="Family roots the Owner marks, and each Person's relation to the family, recomputed in every accepted change.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Mailer, "Mailer", $techn="nodemailer", $descr="Writes each email in the recipient's language and sends it over SMTP.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Proposals, "Proposals", $techn="shared/src/schemas/proposals.ts", $descr="Takes Proposals as typed operations with base versions; requires a Citation; private until accepted.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Review, "Review", $techn="shared/src/schemas/review.ts", $descr="Accepts or rejects a whole Proposal in one transaction, with corrections, conflicts and merges.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Historyandundo, "History and undo", $techn="Kysely", $descr="Append-only log of every change before and after, record history, and undo of a whole Proposal.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Evidencemedia, "Evidence media", $techn="sharp, S3 presigner", $descr="Presigned upload and view links; checks uploads one at a time, keeps the checked bytes and makes a 2,000-pixel WebP copy.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Notificationsanddailyjobs, "Notifications and daily jobs", $techn="In-process scheduler, Prague time", $descr="Editors' digest at 18:00, outcome emails, and deleting images of rejected Proposals after 30 days.", $tags="Component,Built", $link="")
  }

  Container_Boundary("Rodokmen.AppPWA_boundary", "App (PWA)", $tags="Container,Built,Browser") {
    Component(Rodokmen.AppPWA.DraftslistandmyProposals, "Drafts list and my Proposals", $techn="app/src/work.js, api.js", $descr="Submits Drafts once online and shows each Proposal's status and the Editor's note.", $tags="Component,Built", $link="")
    Component(Rodokmen.AppPWA.Reviewandhistoryscreens, "Review and history screens", $techn="app/src/review.js", $descr="Review queue with conflicts and corrections, merging, record history and undo; Agent work is labelled.", $tags="Component,Built", $link="")
    Component(Rodokmen.AppPWA.Settings, "Settings", $techn="Preact with htm, vendored", $descr="Each Member's language, passkeys and sessions; for the Owner invitations, roles, Member–Person links and Family roots.", $tags="Component,Built", $link="")
  }

  ContainerDb(Rodokmen.Database, "Database", $techn="PostgreSQL 16 with PostGIS 3.4", $descr="The Tree, accounts and sessions, Agent tokens, Proposals and the log of accepted changes; the source of truth.", $tags="Container,Built,Data store", $link="")
  ContainerDb(Rodokmen.Imagebucket, "Image bucket", $techn="Garage (S3-compatible), on the VPS", $descr="Private page images, photos and portraits: originals, display copies, and pending/ uploads. Reached by browsers only with presigned links at files.<domain>.", $tags="Container,Built,Data store", $link="")
}

Rel(Rodokmen.AppPWA.DraftslistandmyProposals, Rodokmen.APIserver.Evidencemedia, "Gets an upload link per photo, then completes it", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.DraftslistandmyProposals, Rodokmen.APIserver.Proposals, "Submits with an idempotency key; lists my Proposals", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.DraftslistandmyProposals, Rodokmen.APIserver.Notificationsanddailyjobs, "Turns outcome emails on or off", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.Reviewandhistoryscreens, Rodokmen.APIserver.Review, "Loads the queue; accepts, rejects or merges", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.Reviewandhistoryscreens, Rodokmen.APIserver.Historyandundo, "Shows record history; undoes a Proposal", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.AppPWA.Settings, Rodokmen.APIserver.Familyrootsandrelation, "Lists, marks and removes Family roots", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Mailer, EUemailservice, "Sends from the Rodokmen domain", $techn="SMTP, STARTTLS", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Proposals, Rodokmen.Database, "Stores pending Proposals and their operations", $techn="SQL", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Proposals, Rodokmen.APIserver.Evidencemedia, "Checks that the Proposal's uploads are ready", $techn="JS call", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Review, Rodokmen.Database, "Applies all operations in one transaction", $techn="SQL", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Review, Rodokmen.APIserver.Historyandundo, "Logs each changed record", $techn="JS call", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Review, Rodokmen.APIserver.Evidencemedia, "Moves accepted images out of pending/", $techn="JS call", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Review, Rodokmen.APIserver.Notificationsanddailyjobs, "Sends the author the outcome", $techn="JS call", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Historyandundo, Rodokmen.Database, "Appends to the log; reads it for history and undo", $techn="SQL", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Evidencemedia, Rodokmen.Database, "Records uploads and their checks", $techn="SQL", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Evidencemedia, Rodokmen.Imagebucket, "Presigns links; stores the checked bytes and display copies; moves and deletes images", $techn="S3 API", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Notificationsanddailyjobs, Rodokmen.Database, "Reads pending Proposals; claims each daily job once", $techn="SQL", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Notificationsanddailyjobs, Rodokmen.APIserver.Mailer, "Sends the digest and outcome emails", $techn="JS call", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Notificationsanddailyjobs, Rodokmen.APIserver.Evidencemedia, "Deletes images of Proposals rejected 30 days ago", $techn="JS call", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Review, Rodokmen.APIserver.Familyrootsandrelation, "Recomputes every relation in the same transaction", $techn="JS call", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Familyrootsandrelation, Rodokmen.Database, "Stores Family roots and each Person's relation", $techn="SQL", $tags="Built", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml