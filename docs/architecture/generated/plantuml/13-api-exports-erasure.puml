@startuml
title <size:24>API server: Exports and erasure</size>\n<size:24>The nightly Export, the GEDCOM download and erasure (add-exports-and-erasure).</size>

set separator none
left to right direction

skinparam {
}

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

!include ../../legend.puml

AddElementTag("Software System,External,Built", $bgColor="#8c8c8c", $borderColor="#616161", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Container,Planned", $bgColor="#ffffff", $borderColor="#777777", $fontColor="#555555", $sprite="", $shadowing="", $borderStyle="dashed", $borderThickness="2")
AddElementTag("Component,Planned", $bgColor="#ffffff", $borderColor="#777777", $fontColor="#555555", $sprite="", $shadowing="", $borderStyle="dashed", $borderThickness="2")
AddElementTag("Container,Built,Data store", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Person,Built", $bgColor="#08427b", $borderColor="#052e56", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")

AddRelTag("Planned", $textColor="#8a8a8a", $lineColor="#8a8a8a", $lineStyle = DashedLine())

AddBoundaryTag("Container,Built", $bgColor="#ffffff", $borderColor="#2e6295", $fontColor="#2e6295", $shadowing="", $borderStyle="solid", $borderThickness="2")

Person(Owner, "Owner", $descr="The one Member who invites Members, assigns roles and keeps the Backups.", $tags="Person,Built", $link="")

System(GitHub, "GitHub", $descr="Hosts the code, CI and deploys, the image registry, the map preview and the private Export repo.", $tags="Software System,External,Built", $link="")

System_Boundary("Rodokmen_boundary", "Rodokmen", $tags="Software System,Built") {
  Container_Boundary("Rodokmen.APIserver_boundary", "API server", $tags="Container,Built") {
    Component(Rodokmen.APIserver.Exports, "Exports", $techn="Reduction in shared/", $descr="Markdown and GEDCOM 5.5.1 writers sharing one Living-people reduction; the Owner's GEDCOM download.", $tags="Component,Planned", $link="")
    Component(Rodokmen.APIserver.Erasure, "Erasure", $techn="One transaction", $descr="Erases a Living person from the Tree and the log, and keeps their id for restores and Exports.", $tags="Component,Planned", $link="")
  }

  ContainerDb(Rodokmen.Database, "Database", $techn="PostgreSQL 16 with PostGIS 3.4", $descr="The Tree, accounts and sessions, Proposals and the log of accepted changes; the source of truth.", $tags="Container,Built,Data store", $link="")
  Container(Rodokmen.Exportjob, "Export job", $techn="Node 22, git with a deploy key", $descr="Every night writes the one-way Export: Markdown notes and a GEDCOM file, Living people reduced.", $tags="Container,Planned", $link="")
}

Rel(Rodokmen.Exportjob, Rodokmen.Database, "Reads the Tree and the slug table", $techn="SQL", $tags="Planned", $link="")
Rel(Rodokmen.Exportjob, GitHub, "Commits the Export to rodokmen-export", $techn="Git over SSH, deploy key", $tags="Planned", $link="")
Rel(Rodokmen.APIserver.Exports, Rodokmen.Database, "Reads the Tree and the slug table", $techn="SQL", $tags="Planned", $link="")
Rel(Rodokmen.APIserver.Erasure, Rodokmen.Database, "Deletes the Person, rewrites their log entries, records the id", $techn="SQL, one transaction", $tags="Planned", $link="")
Rel(Owner, Rodokmen.APIserver.Exports, "Downloads the reduced GEDCOM file", $techn="JSON/HTTPS", $tags="Planned", $link="")
Rel(Owner, Rodokmen.APIserver.Erasure, "Erases a Living person after a confirmation", $techn="JSON/HTTPS", $tags="Planned", $link="")
Rel(Rodokmen.Exportjob, Rodokmen.APIserver.Exports, "Runs the Markdown and GEDCOM writers", $techn="Same server code", $tags="Planned", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml