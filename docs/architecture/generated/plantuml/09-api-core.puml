@startuml
title <size:24>API server: accounts, Tree read API and operations</size>\n<size:24>Accounts, the read API and operations (add-tree-backend).</size>

set separator none
left to right direction

skinparam {
}

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

!include ../../legend.puml

AddElementTag("Software System,External,Built", $bgColor="#8c8c8c", $borderColor="#616161", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Container,Built", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Container,Built,Data store", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Component,Built", $bgColor="#85bbf0", $borderColor="#5d82a8", $fontColor="#000000", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")

AddRelTag("Built", $textColor="#555555", $lineColor="#555555", $lineStyle = "")

AddBoundaryTag("Container,Built,Browser", $bgColor="#ffffff", $borderColor="#2e6295", $fontColor="#2e6295", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddBoundaryTag("Container,Built", $bgColor="#ffffff", $borderColor="#2e6295", $fontColor="#2e6295", $shadowing="", $borderStyle="solid", $borderThickness="2")

System(EUemailservice, "EU email service", $descr="Transactional email provider in the EU, sending from the Rodokmen domain.", $tags="Software System,External,Built", $link="")
System(GitHub, "GitHub", $descr="Hosts the code, CI and deploys, the image registry, the map preview and the private Export repo.", $tags="Software System,External,Built", $link="")

System_Boundary("Rodokmen_boundary", "Rodokmen", $tags="Software System,Built") {
  Container_Boundary("Rodokmen.APIserver_boundary", "API server", $tags="Container,Built") {
    Component(Rodokmen.APIserver.Pages, "Pages", $techn="@fastify/static", $descr="Serves app/ at / from the API's own origin, every file with the app's Content-Security-Policy and no-referrer.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Accountsandsignin, "Accounts and sign-in", $techn="@simplewebauthn/server", $descr="Invitations, passkeys, emailed links, sessions and roles; the Member's own Person and language; checks the session or Agent token and the action on every request.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.TreereadAPI, "Tree read API", $techn="Recursive SQL, PostGIS", $descr="Person search across Names with the relation filter, records, ancestors, descendants and the hourglass, and Events for a map area, years or a Place.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.OpenAPI, "OpenAPI", $techn="@fastify/swagger, Zod", $descr="Publishes /api/openapi.json, generated from the same shared schemas that check requests.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Health, "Health", $techn="Fastify route", $descr="Health check at /api/health, used by deploys, the watchdog and outside monitors.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Mailer, "Mailer", $techn="nodemailer", $descr="Writes each email in the recipient's language and sends it over SMTP.", $tags="Component,Built", $link="")
    Component(Rodokmen.APIserver.Evidencemedia, "Evidence media", $techn="sharp, S3 presigner", $descr="Presigned upload and view links; checks uploads one at a time, keeps the checked bytes and makes a 2,000-pixel WebP copy.", $tags="Component,Built", $link="")
  }

  Container_Boundary("Rodokmen.AppPWA_boundary", "App (PWA)", $tags="Container,Built,Browser") {
    Component(Rodokmen.AppPWA.Signinscreens, "Sign-in screens", $techn="app/src/sign-in-screen.js, webauthn.js", $descr="Accepts an invitation and registers a passkey; signs in with a passkey or an emailed link. Emails link here.", $tags="Component,Built", $link="")
  }

  Container(Rodokmen.Serviceworker, "Service worker", $techn="Service Worker, Cache Storage", $descr="Precaches the app and reference data per release and keeps up to 2,000 viewed tiles, so the map works offline.", $tags="Container,Built", $link="")
  Container(Rodokmen.MCPserver, "MCP server", $techn="TypeScript, MCP SDK v2; stdio or streamable HTTP", $descr="Lets AI assistants search the Tree and submit Proposals; a thin client of the API with the Agent's token, without database access.", $tags="Container,Built", $link="")
  ContainerDb(Rodokmen.Database, "Database", $techn="PostgreSQL 16 with PostGIS 3.4", $descr="The Tree, accounts and sessions, Agent tokens, Proposals and the log of accepted changes; the source of truth.", $tags="Container,Built,Data store", $link="")
  ContainerDb(Rodokmen.Imagebucket, "Image bucket", $techn="Garage (S3-compatible), on the VPS", $descr="Private page images, photos and portraits: originals, display copies, and pending/ uploads. Reached by browsers only with presigned links at files.<domain>.", $tags="Container,Built,Data store", $link="")
  Container(Rodokmen.Watchdog, "Watchdog", $techn="Node 22, API image, cli.js watchdog", $descr="Emails the Owner when the health check fails for over 5 minutes or a Backup fails or is missing.", $tags="Container,Built", $link="")
}

Rel(Rodokmen.AppPWA.Signinscreens, Rodokmen.APIserver.Accountsandsignin, "Accepts invitations, registers passkeys, signs in with a passkey or an emailed link", $techn="JSON/HTTPS", $tags="Built", $link="")
Rel(Rodokmen.Serviceworker, Rodokmen.APIserver.Pages, "Precaches the app at each release", $techn="HTTPS GET", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Accountsandsignin, Rodokmen.Database, "Stores accounts, passkeys, sessions and hashed tokens", $techn="SQL", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Accountsandsignin, Rodokmen.APIserver.Mailer, "Sends invitations and sign-in links", $techn="JS call", $tags="Built", $link="")
Rel(Rodokmen.APIserver.TreereadAPI, Rodokmen.Database, "Searches Names; walks ancestors with recursive SQL", $techn="SQL, PostGIS", $tags="Built", $link="")
Rel(Rodokmen.APIserver.TreereadAPI, Rodokmen.APIserver.Evidencemedia, "Gets view links for images", $techn="JS call", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Health, Rodokmen.Database, "Checks the database answers", $techn="SQL", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Mailer, EUemailservice, "Sends from the Rodokmen domain", $techn="SMTP, STARTTLS", $tags="Built", $link="")
Rel(Rodokmen.APIserver.Evidencemedia, Rodokmen.Imagebucket, "Presigns links; stores the checked bytes and display copies; moves and deletes images", $techn="S3 API", $tags="Built", $link="")
Rel(Rodokmen.MCPserver, Rodokmen.APIserver.TreereadAPI, "Searches Persons, Places and Sources; reads records, ancestors and descendants", $techn="JSON/HTTP(S), Agent token", $tags="Built", $link="")
Rel(Rodokmen.Watchdog, Rodokmen.APIserver.Health, "Checks /api/health through the public URL", $techn="HTTPS", $tags="Built", $link="")
Rel(GitHub, Rodokmen.APIserver.Health, "Checks /api/health after each deploy", $techn="HTTPS", $tags="Built", $link="")
Rel(GitHub, Rodokmen.APIserver.OpenAPI, "Fails CI when routes and description disagree", $techn="cli.js openapi check", $tags="Built", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml